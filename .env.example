# Fresh Tech Website - Environment Variables
# Copy this file to .env.local for local development
# In production (Netlify), set these in the dashboard

# ============================================================
# REQUIRED
# ============================================================

# Password for accessing /blog/scheduled page (draft posts)
# IMPORTANT: This is a SERVER-SIDE variable (no VITE_ prefix).
# Set in Netlify dashboard under Site Settings > Environment Variables.
# It is verified by the Netlify function, never exposed to the browser.
# SCHEDULED_PASSWORD=your-secure-password-here

# ============================================================
# ANALYTICS (Optional for development)
# ============================================================

# Google Analytics 4 Measurement ID
# Get from: Google Analytics → Admin → Data Streams → Web
# Format: G-XXXXXXXXXX
VITE_GA4_ID=

# Microsoft Clarity Project ID
# Get from: clarity.microsoft.com → Project Settings
# Format: alphanumeric string
VITE_CLARITY_ID=

# ============================================================
# NETLIFY FUNCTIONS (Production only)
# ============================================================
# These are set in Netlify dashboard, not in .env files

# SMTP2GO API Key (for contact form email)
# SMTP2GO_API_KEY=api-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email recipient for contact form submissions
# CONTACT_EMAIL=hello@fresh-tech.uk

# Password for /blog/scheduled page (validated server-side)
# SCHEDULED_PASSWORD=your-secure-password-here

# ============================================================
# CLOUDINARY (image uploads — local script only, not used at runtime)
# ============================================================
# Used by scripts/upload-cloudinary.js to upload blog hero images.
# Cloud name is public; key/secret authorise uploads.
# Get from: cloudinary.com → Dashboard → Settings → API Keys
# CLOUDINARY_CLOUD_NAME=djkmeg5se
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
