---
// Decorative glyphs for the team pages (lucide-react v0.554.0 shapes, ISC),
// drawn inline from src/lib/team-display.mjs.
import { teamIconNodes } from '../lib/team-display.mjs';

interface Props { name: string; size?: number; class?: string }
const { name, size = 24, class: className } = Astro.props;
const nodes = teamIconNodes(name);
---
<svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {nodes.map(([Tag, attrs]) => <Tag {...attrs} />)}
</svg>
