---
// One line of RichText tokens (src/lib/rich-text.mjs) rendered as elements or
// escaped text, never set:html.
interface Token { type: 'text' | 'strong' | 'em' | 'link'; value?: string; href?: string; external?: boolean; label?: string }
interface Props { tokens: Token[] }
const { tokens } = Astro.props;
---

{tokens.map(token => {
  if (token.type === 'strong') return <strong>{token.value}</strong>;
  if (token.type === 'em') return <em>{token.value}</em>;
  if (token.type === 'link') return <a href={token.href} target={token.external ? '_blank' : undefined} rel={token.external ? 'noopener noreferrer' : undefined}>{token.label}</a>;
  return token.value;
})}
