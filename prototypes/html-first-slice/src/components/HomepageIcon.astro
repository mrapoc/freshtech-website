---
interface Props { name: string }
const { name } = Astro.props;
---
<svg class="home-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'shield' && <path d="M12 22s8-4 8-12V5l-8-3-8 3v5c0 8 8 12 8 12z" />}
  {name === 'lock' && <><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></>}
  {name === 'cloud' && <path d="M17.5 19a4.5 4.5 0 1 0-1.5-8.7 6 6 0 0 0-11.6 1.7A4 4 0 0 0 6 19h11.5z" />}
  {name === 'rocket' && <><path d="M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.9.7-2.2-.1-3a2.1 2.1 0 0 0-2.9 0z" /><path d="M12 15l-3-3a22 22 0 0 1 8-11c4 0 6 2 6 6a22 22 0 0 1-11 8z" /></>}
  {name === 'database' && <><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14a9 3 0 0 0 18 0V5" /><path d="M3 12a9 3 0 0 0 18 0" /></>}
</svg>
