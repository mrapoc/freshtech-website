---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import IndustriesListing from '../../components/IndustriesListing.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteNav from '../../components/SiteNav.astro';
import { industries } from '../../generated/industries-data.mjs';
import { listingSeo } from '../../lib/industry-seo.mjs';
import '../../styles/industries.css';
import PrototypeBanner from '../../components/PrototypeBanner.astro';

const seo = listingSeo();
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} ogType={seo.ogType} schemas={seo.schemas} robots={seo.robots} preloadFonts={['/fonts/bungee-latin.woff2']}>
  <PrototypeBanner />
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <SiteNav activePage="" />
  <IndustriesListing industries={industries} />
  <SiteFooter />
  <CookieConsent />
</BaseLayout>

<script src="../../scripts/enhance.ts"></script>
