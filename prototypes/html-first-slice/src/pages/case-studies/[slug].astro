---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { caseStudies } from '../../generated/case-studies-data.mjs';
import { detailSeo } from '../../lib/case-study-seo.mjs';
import '../../styles/services.css';
import '../../styles/case-studies.css';
import PrototypeBanner from '../../components/PrototypeBanner.astro';

export function getStaticPaths() {
  return caseStudies.map(study => ({ params: { slug: study.slug }, props: { study } }));
}

const { study } = Astro.props;
const seo = detailSeo(study);
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} ogType={seo.ogType} schemas={seo.schemas} robots={seo.robots} preloadFonts={['/fonts/bungee-latin.woff2']} pageFamily="case-studies">
  <PrototypeBanner />
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <SiteNav activePage="Case Studies" />
  <CaseStudyPage study={study} studies={caseStudies} />
  <SiteFooter />
  <CookieConsent />
</BaseLayout>

<script src="../../scripts/enhance.ts"></script>
