---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactForm from '../components/ContactForm.astro';
import { sharedSchemas } from '../lib/service-seo.mjs';
import { resolveSiteMode } from '../lib/site-mode.mjs';

const canonical = 'https://fresh-tech.uk/contact';
const calendlyUrl = 'https://calendly.com/fresh-sam/20min';
const production = resolveSiteMode(import.meta.env.PUBLIC_SITE_MODE) === 'production';
const configuredMode = import.meta.env.PUBLIC_CONTACT_SUBMISSION_MODE;
const submissionMode = production ? 'enabled' : configuredMode === 'enabled' || configuredMode === 'test' ? configuredMode : 'disabled';
const { localBusiness, organization } = sharedSchemas();
const schemas = [localBusiness, organization, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fresh-tech.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: canonical },
  ],
}];
const towns = ['Ludlow', 'Shrewsbury', 'Hereford', 'Telford', 'Leominster', 'Craven Arms', 'Church Stretton', 'Bridgnorth', 'Oswestry', 'Welshpool'];
const faqs = [
  { question: 'How quickly will you actually respond?', answer: production ? 'Our office hours are Mon–Fri, 9am–5pm. Contact us to discuss support response commitments.' : 'Our office hours are Mon–Fri, 9am–5pm. Available helpdesk averages are shown on the live site, but are not connected in this static preview. Contact us to discuss support response commitments.' },
  { question: "We're already under contract with our IT provider, can we still talk?", answer: "Yes. We're happy to have an honest conversation about your options. We won't pressure you to break a contract, and we can often help plan a clean switch for when the right moment comes." },
  { question: 'Do you cover our area?', answer: "We support businesses across Shropshire, Herefordshire and the Welsh Borders, primarily within roughly 30 miles of Ludlow. If you're outside that, call us anyway and we'll tell you honestly." },
  { question: 'Is there a minimum contract?', answer: 'Our standard service is on a 30-day rolling term unless a signed Proposal says otherwise.', termsLink: true },
] as const;
---

<BaseLayout
  title="Book a Call: IT Support Shropshire | Fresh Tech IT Support"
  description="Book a free 20-minute call with Fresh Tech, IT support for Shropshire businesses. No sales script, no obligation. Call 01584 517 234 or pick a time online."
  canonical={canonical}
  schemas={schemas}
>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  {!production && <div class="prototype-banner">HTML-first contact comparison. Local preview only.</div>}
  <SiteNav activePage="Contact" />
  <main id="main-content" tabindex="-1" class="contact-page">
    <section class="contact-hero" aria-labelledby="contact-heading">
      <div class="hero-inner">
        <div>
          <div class="eyebrow light">Contact HQ</div>
          <h1 id="contact-heading">Two engineers.<br />One phone number.<br />No queue.</h1>
          <p class="lead">Tell us what's happening. A real person in Ludlow comes back to you.</p>
          {!production && <p class="metric-hold">Live helpdesk averages are not connected in this static preview.</p>}
        </div>
        <div class="reach-us" role="group" aria-labelledby="reach-us-label">
          <div class="reach-label" id="reach-us-label">Three ways to reach us</div>
          <a class="reach-option primary" href={calendlyUrl} target="_blank" rel="noopener noreferrer"><strong>Book a call</strong><span>Pick a time on Calendly. External booking service opens in a new tab.</span></a>
          <a class="reach-option" href="tel:+441584517234"><strong>01584 517 234</strong><span>Mon–Fri, 9am–5pm. Ludlow picks up.</span></a>
          <a class="reach-option" href="mailto:hello@fresh-tech.uk"><strong>hello@fresh-tech.uk</strong><span>Send us the details by email.</span></a>
        </div>
      </div>
    </section>

    <section class="start-section" aria-labelledby="start-heading">
      <div class="section-intro"><div class="eyebrow">Get in touch</div><h2 id="start-heading">Pick how you'd like to start</h2><p>No wrong answer. Both end up with a real conversation.</p></div>
      <div class="option-grid">
        <article class="book-panel">
          <div class="panel-tag">Most popular</div><div class="eyebrow">Option 01</div><h3>Book a 20-min call</h3>
          <p>Pick a time on Sam's calendar. We'll talk through your setup, answer questions, and tell you honestly whether we're a good fit.</p>
          <div class="what-you-get"><strong>20</strong><span><b>What you'll get</b>A 20-minute slot with Sam or Matthew. No sales pitch, no obligation.</span></div>
          <a class="button-link accent" href={calendlyUrl} target="_blank" rel="noopener noreferrer">Open booking page on Calendly <span aria-hidden="true">→</span></a>
          <small>External booking service opens in a new tab. Mon–Fri, 9am–5pm.</small>
        </article>
        <article class="direct-panel">
          <div class="eyebrow light">Option 02</div><h3>Call us now</h3>
          <p>Existing customer or urgent issue? Call direct. A real person in Ludlow picks up, not a queue, not a bot.</p>
          <a class="button-link phone" href="tel:+441584517234">01584 517 234</a>
          {!production && <p class="metric-hold">Live average response and call-wait figures are deferred in this static preview.</p>}
          <a class="email-link" href="mailto:hello@fresh-tech.uk">Or email <strong>hello@fresh-tech.uk</strong></a>
          <p>Existing clients can email <a href="mailto:support@fresh-tech.uk">support@fresh-tech.uk</a> for help.</p>
        </article>
      </div>
    </section>

    <section class="message-section"><ContactForm submissionMode={submissionMode} /></section>

    <section class="faq-section" aria-labelledby="faq-heading">
      <div class="section-intro centred"><div class="eyebrow">Common questions</div><h2 id="faq-heading">Before you get in touch</h2></div>
      <div class="faqs">{faqs.map(({ question, answer, termsLink }) => <details data-disclosure><summary>{question}</summary><p>{answer}{termsLink && <> Read our <a href="/terms-of-business">Terms of Business</a>.</>}</p></details>)}</div>
    </section>

    <section class="coverage" aria-labelledby="coverage-heading">
      <h2 id="coverage-heading">We cover</h2>
      <ul>{towns.map(town => <li>{town}</li>)}<li>+ surrounding areas</li></ul>
      <p>Not sure if you're in range? Call us, we'll tell you straight.</p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .contact-page { background: #f5f2e9; color: #172433; }
  .contact-hero { background: #172433; color: #fff; padding: clamp(3.5rem, 7vw, 5rem) 1rem; }
  .hero-inner, .start-section, .message-section, .faq-section { width: min(1100px, 100%); margin-inline: auto; }
  .hero-inner { display: grid; gap: 2.25rem; }
  .hero-inner > *, .option-grid > *, .what-you-get > * { min-width: 0; }
  .eyebrow { color: #0f6f68; font-size: .78rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .eyebrow.light { color: #77c9bd; }
  h1 { margin: .5rem 0 1.2rem; color: #fff; font-size: clamp(2.45rem, 7vw, 4rem); line-height: 1.04; letter-spacing: -.035em; }
  .lead { max-width: 40ch; color: #d9e0e5; font-size: 1.12rem; line-height: 1.6; }
  .metric-hold { color: #b7c2ca; font-size: .88rem; }
  .reach-us { display: grid; gap: .5rem; align-content: center; }
  .reach-label { color: #a7b3bc; font-size: .75rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .reach-option { display: grid; gap: .2rem; border: 1px solid #465462; background: #202e3c; color: #fff; padding: 16px 20px; text-decoration: none; }
  .reach-option.primary { border-color: #3288be; background: #213d50; }
  .reach-option.primary strong { color: #77c9bd; }
  .reach-option span { color: #bdc7ce; font-size: .84rem; }
  .reach-option:hover { border-color: #f5b700; }
  .start-section, .message-section, .faq-section { padding: clamp(3.5rem, 7vw, 5rem) 1rem; }
  .section-intro { margin-bottom: 2rem; }
  .section-intro h2 { margin: .45rem 0 .65rem; font-size: clamp(2rem, 5vw, 2.8rem); }
  .option-grid { display: grid; gap: 1.5rem; }
  .book-panel, .direct-panel { position: relative; padding: clamp(24px, 4vw, 40px); }
  .book-panel { border: 2px solid #172433; background: #fff; box-shadow: 6px 6px 0 #172433; }
  .panel-tag { position: absolute; top: -1rem; right: 1rem; border: 2px solid #172433; background: #f5b700; padding: .35rem .8rem; font-weight: 800; transform: rotate(2deg); }
  .book-panel h3, .direct-panel h3 { margin: .5rem 0 .8rem; font-size: 1.8rem; }
  .what-you-get { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin: 1.3rem 0; background: #f5f2e9; padding: 16px; }
  .what-you-get > span { flex: 1 1 180px; }
  .what-you-get > strong { display: grid; place-items: center; flex: 0 0 2.8rem; height: 2.8rem; background: #24734b; color: #fff; font-size: 1.25rem; }
  .what-you-get span, .what-you-get b { display: block; }
  .what-you-get b { margin-bottom: .2rem; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; }
  .button-link { display: block; border: 2px solid currentColor; padding: 14px 16px; text-align: center; font-size: 1rem; font-weight: 800; text-decoration: none; }
  .button-link.accent { background: #c93f10; color: #fff; border-color: #172433; }
  .book-panel small { display: block; margin-top: .8rem; color: #53606d; }
  .direct-panel { background: #172433; color: #fff; }
  .direct-panel > p { color: #cbd4da; }
  .direct-panel .phone { margin: 1.5rem 0; background: #c93f10; color: #fff; }
  .direct-panel a { color: #fff; }
  .email-link { display: block; border-top: 1px solid #53606d; padding-top: 1rem; }
  .message-section { padding-top: 0; }
  .faq-section { max-width: none; background: #ece8dc; }
  .faq-section > * { width: min(1100px, 100%); margin-inline: auto; }
  .centred { text-align: center; }
  .faqs { max-width: 720px; }
  details { border-bottom: 1px solid #7d878f; }
  summary { cursor: pointer; padding: 1.2rem 0; font-size: 1rem; font-weight: 800; }
  details p { margin: 0; padding: 0 0 1.2rem; color: #465462; line-height: 1.65; }
  .coverage { background: #172433; color: #fff; padding: 2.5rem 1rem; text-align: center; }
  .coverage h2 { margin: 0 0 1rem; color: #a7b3bc; font-size: .75rem; letter-spacing: .13em; text-transform: uppercase; }
  .coverage ul { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; width: min(900px, 100%); margin: 0 auto 1rem; padding: 0; list-style: none; }
  .coverage li { border: 1px solid #53606d; background: #202e3c; padding: .4rem .8rem; }
  .coverage p { margin: 0; color: #b7c2ca; }
  a:focus-visible, summary:focus-visible { outline: 4px solid #f5b700; outline-offset: 3px; }
  @media (min-width: 768px) { .hero-inner { grid-template-columns: 1fr 1fr; align-items: center; } }
  @media (min-width: 980px) { .option-grid { grid-template-columns: 1.1fr .9fr; } }
</style>

<script src="../scripts/enhance.ts"></script>
