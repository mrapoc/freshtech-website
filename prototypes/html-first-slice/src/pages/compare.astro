---
// Port of pages-v2/ComparePageV2.tsx. The mobile card layout and desktop table
// were two different DOMs behind a JS width check; a single semantic <table>
// (horizontally scrollable on narrow screens) replaces both without JavaScript,
// same feature order, same cell text. The tick/partial/cross icons are
// decorative SVGs, matching the React <Symbol> component.
import StandaloneShell from '../layouts/StandaloneShell.astro';

const seo = {
  path: '/compare',
  title: "Compare: What We Include That £30 IT Providers Don't",
  description: "Honest comparison: Fresh Tech Standard at £40/user vs a typical national IT provider at £30/user vs DIY in-house IT. Twelve rows of what's actually in the price.",
  type: 'service',
};

const ROWS = [
  { feature: 'Huntress managed EDR + identity threat detection', us: ['yes', 'Included on every tier, Standard included'], them: ['no', 'Usually £6–10/user/month extra'], diy: ['no', "You'd need to buy + manage it yourself"] },
  { feature: 'Microsoft 365 backup (mail, OneDrive, SharePoint, Teams)', us: ['yes', 'Independent third-party backup, included'], them: ['no', 'Often £4–8/user/month extra'], diy: ['partial', 'Most assume Microsoft "has it covered", but they don\'t'] },
  { feature: 'DMARC policy management', us: ['yes', 'Configured and monitored'], them: ['no', 'Typically a project, often not done at all'], diy: ['no', 'Specialist skill, rarely done in-house'] },
  { feature: 'Cloudflare DNS management', us: ['yes', "We hold DNS so third parties can't break your email"], them: ['partial', 'Often pointed at a registrar nobody owns'], diy: ['partial', 'Usually whoever set up the website years ago'] },
  { feature: 'Cyber Essentials maintenance + evidence pack', us: ['yes', 'Year-round; ready for annual assessment'], them: ['partial', 'Often a paid project, redone yearly'], diy: ['no', 'Multi-week internal project + assessor cost'] },
  { feature: 'Basic shared webhosting', us: ['yes', 'Included if you need a simple business site'], them: ['no', 'Separate hosting bill, usually £15–30/month'], diy: ['partial', 'GoDaddy / 123-reg retail rates'] },
  { feature: 'Domain renewal absorbed (standard TLDs)', us: ['yes', '.co.uk, .com, .uk, .org, .net etc, at our cost'], them: ['no', 'You pay registrar retail (~£25–40/year)'], diy: ['no', 'Retail rates from your registrar'] },
  { feature: 'Onsite support', us: ['partial', 'Remote-first on every tier; onsite only when remote cannot fix it, billed separately'], them: ['partial', 'Often "billable on top" once you\'re past 20 miles'], diy: ['no', "You're the onsite"] },
  { feature: 'Named engineer who knows your business', us: ['yes', 'Two engineers, you talk to one of us, directly'], them: ['no', 'A ticket queue, rotating helpdesk'], diy: ['partial', "One person, and if they're ill, no cover"] },
  { feature: 'Response time on critical issues', us: ['yes', 'P1 within 30 minutes on every tier'], them: ['partial', 'Best-efforts, often 1–4 hours'], diy: ['partial', 'Whenever they get to it / are in the office'] },
  { feature: 'Holiday & sickness cover', us: ['yes', 'Two of us means continuous cover'], them: ['yes', 'Helpdesk model handles cover by design'], diy: ['no', 'If your IT person is off, nothing happens'] },
  { feature: 'Indicative monthly cost (20-user business)', us: ['yes', 'Standard £800/mo · Plus £1,200/mo · Premium £1,800/mo'], them: ['partial', '£600/mo headline + ~£300/mo of "extras" usually billed on top'], diy: ['no', '£3,500–4,000/mo (salary loaded for 1 FTE)'] },
];

const SYMBOL = {
  yes: '<svg width="20" height="20" viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="11" fill="#2E7D5B" fill-opacity="0.18"/><path d="M6.5 11.5l3 3 6-6.5" stroke="#2E7D5B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  partial: '<svg width="20" height="20" viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="11" fill="#F5C24A" fill-opacity="0.3"/><path d="M6.5 11h9" stroke="#0F1923" stroke-width="2.4" stroke-linecap="round"/></svg>',
  no: '<svg width="20" height="20" viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="11" fill="#C8443A" fill-opacity="0.15"/><path d="M7 7l8 8M15 7l-8 8" stroke="#C03F35" stroke-width="2.4" stroke-linecap="round"/></svg>',
};
---

<StandaloneShell name="compare" seo={seo}>
  <section class="sa-hero">
    <div class="sa-wrap" style="--sa-max: 1100px">
      <p class="sa-eyebrow sa-eyebrow-light">Honest comparison</p>
      <h1 class="sa-display sa-display-light" style="--sa-size: 50px; --sa-size-mobile: 36px; margin-bottom: 20px; max-width: 20ch">What we include that £30 IT providers don't.</h1>
      <p class="sa-lead" style="max-width: 60ch">We're not the cheapest. We're not pretending to be. This page is a no-spin comparison of what's actually in the price: Fresh Tech Standard versus a typical national IT provider at £30/user, versus doing it yourself in-house.</p>
      <p class="cp-italic">Tick = fully included. Half-tick = partially / sometimes / extra-cost. Cross = not included or has to be done another way.</p>
    </div>
  </section>

  <section class="sa-section sa-paper">
    <div class="sa-wrap" style="--sa-max: 1200px">
      <div class="cp-table-wrap">
        <table class="cp-table">
          <thead>
            <tr>
              <th class="cp-th-feature">Feature</th>
              <th><span class="cp-th-brand">Fresh Tech</span> <span class="cp-th-sub">Standard · £40/user</span></th>
              <th><span class="cp-th-brand cp-th-brand-light">National IT provider</span> <span class="cp-th-sub">Typical · £30/user</span></th>
              <th><span class="cp-th-brand cp-th-brand-light">DIY in-house</span> <span class="cp-th-sub">You / your team</span></th>
            </tr>
          </thead>
          <tbody>
            {ROWS.map(row => (
              <tr>
                <td class="cp-feature">{row.feature}</td>
                {(['us', 'them', 'diy'] as const).map(col => (
                  <td class="cp-cell"><Fragment set:html={SYMBOL[row[col][0]]} /><span>{row[col][1]}</span></td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cp-footnote">"Typical national IT provider" figures are based on published price lists and procurement quotes we've seen from clients switching to us in 2025–2026. Your mileage may vary, every provider differs. The point is that <strong>£10/month/user buys a lot more than people think</strong> once you account for the line items above.</p>
    </div>
  </section>

  <section class="sa-section sa-ink sa-rule">
    <div class="sa-wrap" style="--sa-max: 900px">
      <p class="sa-eyebrow sa-eyebrow-light">Why we're not the cheapest</p>
      <h2 class="sa-display sa-display-light" style="--sa-size: 32px; margin-bottom: 16px">£10 buys you peace of mind, not paperwork.</h2>
      <p class="cp-dark-lead">Most clients who quote-shop discover the £30 headline becomes £45–55 after the add-ons that should have been included. Worse, the bits they didn't think to ask about, such as DMARC, M365 backup, identity threat detection, usually aren't there at all. They find out when the breach happens.</p>
      <p class="cp-dark-p">Fresh Tech's pricing is indicative: we'll quote you exactly during a 20-minute discovery call once we know your user count, sites, and devices. <a class="cp-yellow-link" href="/contact">Book one →</a></p>
    </div>
  </section>

  <section class="sa-section sa-paper sa-rule">
    <div class="sa-wrap cp-final-grid" style="--sa-max: 1100px">
      <div>
        <p class="sa-eyebrow">Want a side-by-side on your current provider?</p>
        <h2 class="sa-display" style="--sa-size: 32px; margin-bottom: 12px">Send us your IT invoice</h2>
        <p class="cp-final-p">We'll do a free, honest breakdown of what you're paying for vs what's actually in the bill, even if our answer is "stay where you are."</p>
        <p class="cp-final-note">PDF invoices only · Handled securely · No sales calls</p>
      </div>
      <a class="sa-button cp-final-btn" href="/contact?ref=spend-review">Request a free review →</a>
    </div>
    <p class="cp-reviewed">Last reviewed May 2026 · Sam James</p>
  </section>
</StandaloneShell>

<style>
  .cp-italic { color: rgba(255,255,255,0.55); font-size: 14px; line-height: 1.6; margin: 0; max-width: 60ch; font-style: italic; }
  .cp-table-wrap { overflow-x: auto; border: 2px solid var(--ink); box-shadow: 6px 6px 0 0 var(--ink); background: var(--white); }
  .cp-table { border-collapse: collapse; width: 100%; min-width: 720px; }
  .cp-table thead tr { background: var(--ink); }
  .cp-table th { padding: 16px 18px; text-align: center; vertical-align: top; }
  .cp-th-feature { text-align: left; font: 700 11px/1.3 'SA Archivo Narrow', sans-serif; text-transform: uppercase; letter-spacing: .14em; color: rgba(255,255,255,0.55); }
  .cp-th-brand { display: block; font: 400 15px/1.2 'SA Bungee', 'SA Archivo', system-ui, sans-serif; color: var(--yellow); }
  .cp-th-brand-light { color: rgba(255,255,255,0.85); }
  .cp-th-sub { display: block; font: 700 10px/1.3 'SA Archivo Narrow', sans-serif; text-transform: uppercase; letter-spacing: .12em; color: rgba(255,255,255,0.6); margin-top: 4px; }
  .cp-table tbody tr:nth-child(even) { background: var(--paper); }
  .cp-table tbody tr:not(:last-child) { border-bottom: 1px solid var(--hairline); }
  .cp-feature { padding: 14px 18px; font-size: 14px; font-weight: 600; color: var(--ink); }
  .cp-cell { padding: 14px 18px; vertical-align: top; }
  .cp-cell svg { display: block; margin: 0 auto 6px; }
  .cp-cell span { display: block; text-align: center; font-size: 12px; color: var(--ink); opacity: 0.75; line-height: 1.5; }
  .cp-footnote { margin: 24px 0 0; padding: 16px 20px; background: var(--paper-deep); border: 1px solid var(--hairline); font-size: 13px; color: var(--ink); opacity: 0.7; line-height: 1.6; }
  .cp-dark-lead { font-size: 17px; color: rgba(255,255,255,0.7); line-height: 1.7; margin: 0 0 16px; max-width: 64ch; }
  .cp-dark-p { font-size: 15px; color: rgba(255,255,255,0.55); line-height: 1.65; margin: 0; max-width: 64ch; }
  .cp-yellow-link { color: var(--yellow); font-weight: 600; }
  .cp-final-grid { display: grid; grid-template-columns: 1fr; gap: 24px; align-items: center; }
  @media (min-width: 768px) { .cp-final-grid { grid-template-columns: 1fr auto; gap: 32px; } }
  .cp-final-p { font-size: 16px; color: var(--ink); opacity: 0.75; line-height: 1.65; margin: 0 0 6px; max-width: 52ch; }
  .cp-final-note { font-size: 13px; color: rgba(15,25,35,.78); margin: 0; }
  .cp-final-btn { white-space: normal; max-width: 100%; justify-self: start; }
  .cp-reviewed { text-align: center; padding: 20px 16px 0; font: 700 11px/1.3 'SA Archivo Narrow', sans-serif; text-transform: uppercase; letter-spacing: .14em; color: #46545f; margin: 0; }
</style>
