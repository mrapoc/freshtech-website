---
// Port of pages-v2/EmailSecurityGuidePageV2.tsx.
// Differences from production, documented here and in standalone-differences.mjs:
// 1. EmailCheckerTool (components-v2/EmailCheckerTool.tsx) is the same tool as
//    /email-security-check, ported as the shared src/components/EmailChecker.astro
//    (markup) plus src/scripts/email-checker.ts (behaviour, loaded on demand by
//    src/scripts/enhance.ts): live DNS-over-HTTPS checks, no lead is posted
//    anywhere (see email-checker.ts's file-level comment).
// 2. The "Copy these questions" button copies the same numbered list React
//    copies (components-v2/EmailSecurityGuidePageV2.tsx's copyQuestions), via
//    navigator.clipboard with a document.execCommand fallback, mirroring the
//    copy button on /ai-acceptable-use-policy.
// 3. CalendlyModal is not portable statically, so the "Book a 15-min call" button
//    becomes a plain <a href="/contact"> link, per project convention. This adds
//    one link versus the captured baseline, documented in
//    scripts/lib/standalone-differences.mjs under this route.
// 4. LastReviewed's light-on-ink footer text (rgba(255,255,255,0.35), ~3.2:1) is
//    bumped to rgba(255,255,255,0.5) (~5.2:1) to clear WCAG AA for small text,
//    same approach as the rest of standalone.css.
import StandaloneShell from '../layouts/StandaloneShell.astro';
import EmailChecker from '../components/EmailChecker.astro';

const seo = {
  path: '/email-security-guide',
  title: 'SPF, DKIM & DMARC in Plain English | Email Security Guide',
  description: 'Can anyone send email pretending to be your business? A plain-English guide to SPF, DKIM and DMARC, the free settings that stop spoofing and keep your own email out of spam.',
  type: 'article',
};

const PILLARS = [
  {
    name: 'SPF', slug: 'spf',
    tag: 'The guest list of servers allowed to send as you.',
    analogy: 'A guest list on the door: if a server is not on the list, it does not get to send mail in your name.',
    plain: "SPF (Sender Policy Framework) is a short record in your domain's DNS, the public address book for your website and email. It lists the mail servers that are allowed to send email for your domain. When a message arrives, the receiving server can check it against that list.",
    risk: 'With no SPF, there is no published list of who is allowed to send as you, so receiving servers have less reason to trust your mail. Your own genuine email is more likely to be treated as suspicious and pushed towards spam.',
    fix: 'It is free and built in. With Microsoft 365 you publish a single TXT record in your DNS, typically v=spf1 include:spf.protection.outlook.com -all. With Google Workspace it is one TXT record, v=spf1 include:_spf.google.com ~all. There is no licence and no add-on: it is included with every plan and is roughly a five-minute job once you are in your DNS. Only one SPF record is allowed per domain, so it needs to list every legitimate sender (your mail platform, your CRM, your accounts software).',
  },
  {
    name: 'DKIM', slug: 'dkim',
    tag: 'A tamper-proof signature that proves a message is really yours.',
    analogy: 'A wax seal on a letter: if the seal is intact, the recipient knows it came from you and was not opened or altered on the way.',
    plain: 'DKIM (DomainKeys Identified Mail) adds an invisible, tamper-proof signature to every email you send. The receiving server checks that signature against a key published in your DNS, which proves the message genuinely came from your domain and was not altered in transit.',
    risk: 'Without DKIM on your own domain, receivers cannot confirm your messages are genuinely from you or that they arrived unaltered, which weakens trust and your deliverability. A subtle trap: Google Workspace does sign outgoing mail by default, but with a Google-owned key that does not line up with your own domain, so it does not satisfy DMARC. You can wrongly believe you are authenticated when you are not.',
    fix: 'Free and built in, just a touch more involved than SPF. In Microsoft 365 you enable DKIM in the Microsoft Defender portal by publishing two CNAME records and flicking a toggle. Worth knowing: the built-in onmicrosoft.com address is signed automatically, but your own custom domain is not signed until you switch it on, so it is worth confirming that has actually been done. In Google Workspace you generate the key in the Admin console, publish one TXT record, then turn authentication on. Both are included in the subscription at no extra cost and take about five minutes of hands-on work.',
  },
  {
    name: 'DMARC', slug: 'dmarc',
    tag: 'The policy that actually blocks impersonation, if you let it.',
    analogy: "The instruction the bouncer enforces. A smoke alarm set to 'monitor only' is just a smoke alarm with the speaker disconnected: it notices the fire but warns nobody.",
    plain: 'DMARC (Domain-based Message Authentication) ties SPF and DKIM together. It tells receiving mail servers what to do with a message that fails the checks, and it sends you back reports showing who is sending mail in your name. It is the piece that requires the visible From address you read to line up with an authenticated sender.',
    risk: 'The catch is the setting. A DMARC policy at p=none is monitor only: it reports who is sending as you, but it tells receivers to take no action, so it blocks nobody from impersonating you. Many businesses have DMARC stuck on p=none and believe the job is done. It looks finished, but spoofing still gets straight through.',
    fix: 'Publishing a basic DMARC record takes minutes, but monitor only is not the goal, it is the floor. The setting that actually stops impersonation is p=quarantine (sends fakes to spam) and then p=reject (refuses them outright). Getting there safely is the one part that is not a five-minute job: it needs a monitoring period first so none of your own legitimate email (invoicing systems, newsletters, CRMs) gets caught in the net. You can monitor DMARC for free using tools that turn the raw reports into a readable dashboard, then tighten the policy in stages. This is the part most worth doing properly rather than rushing, and it is exactly what we include and manage for every client.',
  },
];

const BONUS = [
  {
    name: 'MTA-STS',
    plain: 'MTA-STS is a rule that forces email being sent to your domain to travel encrypted, so it is much harder to quietly intercept or downgrade in transit. It is two pieces: a small DNS record, plus a short policy file served over HTTPS at a web address on your domain. It is meaningfully more work than SPF or DKIM because that policy file has to sit on a web address with a valid security certificate, and your mail platform will not host it for you (Microsoft 365 explicitly does not).',
    fix: 'There is no licence fee. The only potential cost is hosting that small policy file, which can be done for free using something like a Cloudflare Worker or an Azure Static Web App. Best practice is to start in testing mode and switch to enforce once it is validated. Fresh Tech sets this up and includes it for clients.',
  },
  {
    name: 'DNSSEC',
    plain: "DNSSEC is cryptographic protection for your DNS records themselves, so criminals cannot forge your DNS to hijack your email or your website. It has also gained a sharper edge recently: from 15 March 2026, certificate authorities must validate DNSSEC whenever a domain has it switched on. If your domain has no DNSSEC, nothing changes and your security certificates carry on as normal. But if DNSSEC is switched on and set up wrongly, it can now block your website's security certificate from renewing. The takeaway is not 'rush to turn it on', it is 'if it is on, it must be done properly'.",
    fix: 'It is free to switch on at most mainstream DNS providers and registrars. With Cloudflare it is effectively one click on any plan, including the free one, and providers like Namecheap and Porkbun make it straightforward too. The honest caveat: not every budget registrar makes it easy, so on a cheaper provider it can be more fiddly. Fresh Tech sets this up properly and monitors it for clients, rather than leaving it half-done.',
  },
];

const DELIVERABILITY = [
  'In February 2024, Google (Gmail) and Yahoo rolled out new requirements for the people who send email to their users. They are still in force in 2026, and enforcement has tightened, not relaxed. Microsoft followed with the same baseline for its consumer mailboxes (outlook.com, hotmail.com, live.com), enforced from 5 May 2025.',
  "Here is how the rules actually break down, so you know where you stand. Every sender into Gmail and Yahoo needs at least SPF or DKIM. The full SPF, DKIM and DMARC requirement becomes a hard mandate once you are a bulk sender, defined as sending around 5,000 or more messages a day to those providers' personal mailboxes. Most small businesses are nowhere near that line, so the strict mandate may not apply to you directly.",
  "But, and this is the part that matters for everyone, the same checks now drive how all three providers judge whether your everyday email is trustworthy. Even well below the bulk threshold, weak or missing SPF, DKIM and DMARC make your own genuine email more likely to land in customers' spam folders. So this is not only about stopping impersonators. It is about your quotes, invoices and replies actually reaching the inbox.",
  'The direction of travel is one way. Google moved from temporarily delaying non-compliant bulk mail to rejecting it outright in late 2025. Microsoft routes non-compliant high-volume mail (around 5,000 or more messages a day to its consumer mailboxes) to the Junk folder and has said outright rejection will follow. Across all three providers, authentication is becoming the baseline for getting delivered at all.',
];

const DIY_STEPS = [
  'Find out who controls your DNS and your email platform. DNS is usually at your domain registrar or a provider like Cloudflare. Email is almost always Microsoft 365 or Google Workspace. Whoever has the admin login does these jobs.',
  'Publish your SPF record. On Microsoft 365 this is a single TXT record, typically v=spf1 include:spf.protection.outlook.com -all. On Google Workspace it is v=spf1 include:_spf.google.com ~all. Only one SPF record is allowed per domain, and it must list every service that legitimately sends mail for you.',
  'Turn on DKIM for your own domain. On Microsoft 365, go to the Microsoft Defender portal (security.microsoft.com), publish the two CNAME records it gives you, and flip the DKIM toggle. Important: your custom domain is not signed until you do this, even though the built-in onmicrosoft.com address is. On Google Workspace, open the Admin console, generate a DKIM key, publish the one TXT record, then click Start authentication.',
  'Allow time for the changes to take effect. DNS updates can take a little while to register, sometimes up to a day or two, so do not panic if a checker does not show green within minutes.',
  'Confirm it worked. Run a free email security checker against your domain to see SPF and DKIM passing on your own domain (not just the onmicrosoft.com or gappssmtp.com default).',
  'Start DMARC, then plan the climb to enforcement. Publishing a starter DMARC record is quick, but monitor only blocks nothing, so treat that as day one, not done. See the DMARC section below for how to move it up safely.',
];

const DMARC_BODY = [
  'Publishing a basic DMARC record is itself quick: one TXT record. The trap is leaving it on p=none, which is monitor only. At p=none, DMARC reports who is sending as your domain but tells receivers to take no action, so it blocks nobody. Google and Yahoo accept p=none as a starting point to clear their check, which is fine, but clearing the mailbox-provider minimum is not the same as being protected. Monitor only is the floor, not the goal.',
  'To actually stop someone forging your exact domain, the policy has to move up to p=quarantine (fakes go to spam) and then p=reject (fakes are refused outright). That is the part that needs care, because rushing it can block your own legitimate email. The safe approach is to publish DMARC, collect reports for a monitoring period, identify and fix every genuine sender (your accounts software, newsletter tool, CRM and the like), then tighten the policy in stages. A sensible monitoring window is usually several weeks to a few months.',
  "The good news is you can monitor DMARC for free. Cloudflare's DMARC Management tool turns the raw report XML into a readable dashboard showing which senders are passing or failing, and it is free with no report or domain limits for anyone using Cloudflare DNS (including the free plan). It is not the only option: Postmark offers a free weekly DMARC digest by email, and Valimail and dmarcian both have free tiers. Free tiers vary, some give a full dashboard, others just a weekly summary, and some cap the number of domains.",
  'This staged rollout to full enforcement is exactly the sort of thing that gets started and then forgotten on a monitor-only setting. Fresh Tech includes DMARC management for every client: we get it to enforcement safely and keep an eye on the reports so it stays there.',
];

const QUESTIONS = [
  'Do we have an SPF record published, and does it list every service that sends email for us?',
  'Is DKIM switched on for our own domain, not just the default onmicrosoft.com or Google address?',
  'Do we have a DMARC record, and is it set to quarantine or reject rather than left on monitor only (p=none)?',
  'If DMARC is on monitor only, what is the plan and timeline to move it safely to enforcement?',
  'Are we keeping an eye on our DMARC reports, so we know who is sending as us?',
  'Have we set up MTA-STS and DNSSEC, the two extra free layers, or is there a reason we have not yet?',
  "It can be reassuring to see SPF, DKIM and DMARC all passing on our own domain; a free checker will show this, or our IT can confirm it for us.",
];
---

<StandaloneShell name="email-security-guide" seo={seo}>
  <section class="sa-hero esg-hero-dots">
    <div class="sa-wrap" style="--sa-max: 1040px">
      <div class="esg-stickers"><span class="esg-sticker esg-sticker-green" style="transform: rotate(-3deg)">Free to fix</span><span class="esg-sticker" style="transform: rotate(2deg)">Plain English, no jargon</span><span class="esg-sticker esg-sticker-primary" style="transform: rotate(-2deg)">Not a sales pitch</span></div>
      <h1 class="sa-display sa-display-light" style="--sa-size: 46px; --sa-size-mobile: 32px; margin-bottom: 22px; max-width: 20ch">Could someone send an email that looks exactly like it came from your business?</h1>
      <p class="esg-hero-sub">Three small settings decide whether someone can pretend to be your business by email, and whether your own genuine email lands in the inbox or the junk folder. They are called SPF, DKIM and DMARC.</p>
      <p class="esg-hero-note">They are free, built into Microsoft 365 and Google Workspace, and the basics take about five minutes to switch on. Most setups we look at are missing at least one. No sales pitch and no jargon: this page shows you what they are, the real risk, and exactly what to fix or hand to your IT.</p>
      <a class="sa-button" href="#checker">Run my free email security check ↓</a>
    </div>
  </section>

  <section class="sa-section sa-paper sa-rule">
    <div class="sa-wrap" style="--sa-max: 1040px">
      <div class="esg-alert-card">
        <p class="sa-eyebrow esg-eyebrow-red">The bit nobody shows you</p>
        <h2 class="sa-display" style="--sa-size: 34px; --sa-size-mobile: 26px; margin-bottom: 18px">Right now, someone could probably send an email as you</h2>
        <p class="esg-p esg-p-dark">Here is the uncomfortable bit, stated plainly. If your domain has no SPF record and no DMARC policy set to enforce, anyone can send an email that displays your domain in the visible From address, the address you actually read in your inbox. No hacking. No access to your mailbox. No clever toolkit. The way email works, a sender can simply state any From address they like, and if nothing on your domain says otherwise, the message lands looking genuine.</p>
        <p class="esg-p esg-p-dark">That means a fraudster could send a message that appears to come from your finance director asking for an urgent payment, or from you asking a supplier to update their bank details. The reader has no easy way to tell it apart from the real thing. This is the engine behind invoice fraud and CEO scams, and an unprotected domain is the easiest possible target. (To be clear, when we run a check for someone, it is read-only: it reads your public records and never sends mail as you.)</p>
        <p class="esg-p esg-p-dark" style="margin-bottom: 0">One important nuance, because half-measures give a false sense of safety: SPF on its own does not close this gap. SPF only checks a hidden address behind the scenes, not the From line you actually see. So even a domain with SPF set up can still have its exact address forged unless DMARC is published and set to quarantine or reject. The combination that genuinely stops someone forging your exact domain is SPF and DKIM working together with DMARC turned up to enforcement. Set up all three. We will explain each below.</p>
      </div>
    </div>
  </section>

  <section id="checker" class="sa-section sa-deep sa-rule esg-checker-section">
    <div class="sa-wrap sa-center" style="--sa-max: 1040px; margin-bottom: 28px">
      <p class="sa-eyebrow esg-eyebrow-center">See it for yourself</p>
      <h2 class="sa-display" style="--sa-size: 34px; --sa-size-mobile: 26px; margin-bottom: 10px">Check your own domain first</h2>
      <p class="esg-p esg-checker-intro-p">Read-only and instant. Enter your work email and we will read your live public records, then explain each result in plain English. Nothing is changed, and nothing is sent as you.</p>
    </div>
    <div class="sa-wrap" style="--sa-max: 760px">
      <EmailChecker />
    </div>
  </section>

  <section class="sa-section sa-paper sa-rule">
    <div class="sa-wrap" style="--sa-max: 1040px">
      <div style="margin-bottom: 36px">
        <p class="sa-eyebrow">The three that matter</p>
        <h2 class="sa-display" style="--sa-size: 40px; --sa-size-mobile: 30px; margin-bottom: 12px">SPF, DKIM and DMARC, demystified</h2>
        <p class="esg-p" style="max-width: 60ch">These are the minimum to stop someone spoofing your email. Two of them are free, built in and quick. The third is the one that actually does the blocking, and the one most often left half-done.</p>
      </div>
      <div class="esg-pillars">
        {PILLARS.map(p => (
          <div class={`esg-pillar-card esg-pillar-${p.slug}`}>
            <div class="esg-pillar-head"><span class={`esg-pillar-name esg-pillar-name-${p.slug}`}>{p.name}</span><span class="esg-pillar-tag">{p.tag}</span></div>
            <p class="esg-pillar-analogy">{p.analogy}</p>
            <p class="esg-p">{p.plain}</p>
            <div class="esg-pillar-grid">
              <div class="esg-risk-box">
                <div class="esg-box-label esg-box-label-red">What happens without it</div>
                <div class="esg-box-text">{p.risk}</div>
              </div>
              <div class="esg-fix-box">
                <div class="esg-box-label esg-box-label-green">How to fix it</div>
                <div class="esg-box-text">{p.fix}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sa-section sa-deep sa-rule">
    <div class="sa-wrap" style="--sa-max: 1040px">
      <div style="margin-bottom: 32px">
        <p class="sa-eyebrow">Nice to have</p>
        <h2 class="sa-display" style="--sa-size: 34px; --sa-size-mobile: 26px; margin-bottom: 12px">Two extra layers worth knowing about (also free to set up)</h2>
      </div>
      <div class="esg-bonus-grid">
        {BONUS.map(b => (
          <div class="esg-bonus-card">
            <div class="esg-bonus-name">{b.name}</div>
            <p class="esg-p esg-p-15">{b.plain}</p>
            <div class="esg-box-label esg-box-label-primary">The cost and effort</div>
            <p class="esg-p esg-p-15" style="margin-bottom: 0">{b.fix}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sa-section sa-paper sa-rule">
    <div class="sa-wrap" style="--sa-max: 1040px">
      <div style="margin-bottom: 24px">
        <p class="sa-eyebrow">Not just security</p>
        <h2 class="sa-display" style="--sa-size: 36px; --sa-size-mobile: 26px; margin-bottom: 4px">This is not just security. It is whether your own email gets delivered</h2>
      </div>
      {DELIVERABILITY.map(p => <p class="esg-p">{p}</p>)}
    </div>
  </section>

  <section class="sa-section sa-deep sa-rule">
    <div class="sa-wrap" style="--sa-max: 1040px">
      <div style="margin-bottom: 22px">
        <p class="sa-eyebrow">Do it yourself</p>
        <h2 class="sa-display" style="--sa-size: 36px; --sa-size-mobile: 26px; margin-bottom: 12px">How to fix the basics yourself (or hand these steps to your IT)</h2>
        <p class="esg-p" style="max-width: 62ch">The basics, SPF and DKIM, really are about a five-minute job for whoever runs your email and DNS. You do not need to be technical to understand what should happen; you just need to know what to ask for. Here is the short version. One honest note up front: getting DMARC all the way to enforcement is the one part that is not five minutes, and that is covered in its own section below.</p>
      </div>
      <div class="esg-steps">
        {DIY_STEPS.map((s, i) => (
          <div class="esg-step"><span class="esg-step-num">{String(i + 1).padStart(2, '0')}</span><span class="esg-step-text">{s}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sa-section sa-paper sa-rule">
    <div class="sa-wrap" style="--sa-max: 1040px">
      <div style="margin-bottom: 24px">
        <p class="sa-eyebrow">The one that does the blocking</p>
        <h2 class="sa-display" style="--sa-size: 36px; --sa-size-mobile: 26px; margin-bottom: 4px">DMARC: the one that actually blocks impersonation, done properly</h2>
      </div>
      {DMARC_BODY.map(p => <p class="esg-p">{p}</p>)}
    </div>
  </section>

  <section class="sa-section esg-ink-dots sa-rule">
    <div class="sa-wrap" style="--sa-max: 1040px">
      <div style="margin-bottom: 22px">
        <p class="sa-eyebrow sa-eyebrow-light">A polite nudge</p>
        <h2 class="sa-display sa-display-light" style="--sa-size: 36px; --sa-size-mobile: 26px; margin-bottom: 12px">Questions worth asking whoever looks after your IT</h2>
        <p class="esg-questions-intro">None of this is an attack on whoever set your domain up, including if that was you. It is genuinely invisible until something goes wrong, and it is easy to overlook. Think of the list below as what good looks like. If any answer is a no or an 'I'm not sure', treat it as an opportunity to sort one quick thing, not a panic. For what it is worth, this is exactly the sort of thing we pick up on day one when we onboard a new client, so finding a gap here is normal, not a disaster.</p>
      </div>
      <div class="esg-questions-box">
        <ol class="esg-questions-list">
          {QUESTIONS.map((q, i) => (
            <li class="esg-question-item"><span class="esg-question-num">{i + 1}</span><span class="esg-question-text">{q}</span></li>
          ))}
        </ol>
        <button type="button" id="esg-copy" class="esg-copy-btn">Copy these questions</button>
      </div>
    </div>
  </section>

  <section class="sa-section sa-paper sa-rule">
    <div class="sa-wrap" style="--sa-max: 1040px">
      <div style="margin-bottom: 24px">
        <p class="sa-eyebrow">Beyond the free basics</p>
        <h2 class="sa-display" style="--sa-size: 36px; --sa-size-mobile: 26px; margin-bottom: 4px">The next layer up: catching the fakes authentication cannot</h2>
      </div>
      <p class="esg-p">The free DNS records (SPF, DKIM and DMARC) stop other people forging your exact domain and help your own mail get delivered. That is the foundation, and it is genuinely the basics. But there is a layer above it that catches the close-but-not-exact fakes, the ones that do not use your exact domain and so slip past authentication entirely.</p>
      <p class="esg-p">This is where Microsoft 365 Business Premium earns its place. It includes Microsoft Defender for Office 365 Plan 1 as standard, on top of the basic anti-spam and spoofing protection that comes with every mailbox. That adds impersonation protection: it can spot an attacker pretending to be a specific person (for example a fake message in your finance director's name) or using a lookalike domain (for example fresh-teoh.uk in place of fresh-tech.uk), and act on those messages. It also adds Safe Links, which re-checks a link at the moment you click it and blocks it if it has turned malicious, and Safe Attachments, which opens incoming attachments in a sealed sandbox first to catch brand-new malware.</p>
      <p class="esg-p">Business Premium also includes Microsoft Entra ID P1, which brings Conditional Access: sign-in rules such as requiring multi-factor authentication or blocking logins from unrecognised devices, so a stolen password alone is much less likely to get someone in. In short: the free DNS records harden your domain; Business Premium hardens the mailbox and the login. We cover how it compares on our <a href="/microsoft-business-premium">Microsoft 365 Business Premium page</a>. One honest note: impersonation protection is not configured by default, an admin has to set it up, which is, again, exactly the kind of thing we sort on day one.</p>
    </div>
  </section>

  <section class="sa-section esg-ink-dots">
    <div class="sa-wrap sa-center" style="--sa-max: 760px">
      <p class="sa-eyebrow sa-eyebrow-light">No obligation</p>
      <h2 class="sa-display sa-display-light" style="--sa-size: 40px; --sa-size-mobile: 30px; margin-bottom: 16px">Want to know where your domain actually stands?</h2>
      <p class="esg-cta-body">If you would like to check your own setup, our <a href="/email-security-check">free email security check</a> tests your live domain in about twenty seconds: the three core settings (SPF, DKIM and DMARC) plus the two extra layers (MTA-STS and DNSSEC), with each result explained in plain English. It is read-only, so it changes nothing. If you would rather we confirmed the findings and sorted any gaps for you, book a quick call and we will walk you through it. No hard sell: most people just want to know whether the door is open. You can also read the deeper explainer on <a href="/technology/email-authentication">how SPF, DKIM and DMARC work</a>, or, if you are worried about invoice and payment fraud specifically, our guide to <a href="/business-email-compromise">business email compromise</a>.</p>
      <div class="esg-cta-row">
        <a class="sa-button" href="#checker">Run my free email security check ↑</a>{" "}
        <a class="sa-button sa-button-dark" href="/contact">Book a 15-min call →</a>
      </div>
      <p class="esg-phone-note">Prefer to talk? Call <a class="esg-phone-link" href="tel:+441584517234">01584 517 234</a>.</p>
    </div>
    <p class="esg-reviewed">Last reviewed May 2026 · Sam James</p>
  </section>
</StandaloneShell>

<script>
  // Port of pages-v2/EmailSecurityGuidePageV2.tsx's copyQuestions: the same
  // numbered list, joined the same way, with the same "copied" feedback text.
  // The questions are read from the rendered list, so this bundles as an
  // external module and the CSP needs no 'unsafe-inline' for scripts.
  const copyBtn = document.getElementById('esg-copy');
  const questions = [...document.querySelectorAll('.esg-questions-list .esg-question-text')].map(el => el.textContent ?? '');
  copyBtn?.addEventListener('click', async () => {
    const text = questions.map((q, i) => `${i + 1}. ${q}`).join('\n');
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }
    const original = copyBtn.textContent;
    copyBtn.textContent = 'Copied to clipboard ✓';
    setTimeout(() => { copyBtn.textContent = original; }, 2500);
  });
