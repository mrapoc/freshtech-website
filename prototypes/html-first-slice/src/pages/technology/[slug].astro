---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteNav from '../../components/SiteNav.astro';
import TechnologyExplainer from '../../components/TechnologyExplainer.astro';
import { techExplainers, technologyDirectory } from '../../generated/technology-data.mjs';
import { explainerSeo } from '../../lib/technology-seo.mjs';
import '../../styles/technology.css';
import PrototypeBanner from '../../components/PrototypeBanner.astro';

export function getStaticPaths() {
  return techExplainers.map(explainer => ({ params: { slug: explainer.slug }, props: { explainer } }));
}

const { explainer } = Astro.props;
// Preview keeps BaseLayout's noindex default; `robots` is deliberately not passed.
const seo = explainerSeo(explainer);
const headingFontPreloads = /[Ā-ỿⱠ-ꟿ]/u.test(explainer.h1)
  ? ['/fonts/bungee-latin.woff2', '/fonts/bungee-latin-ext.woff2']
  : ['/fonts/bungee-latin.woff2'];
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} ogType={seo.ogType} schemas={seo.schemas} preloadFonts={headingFontPreloads}>
  <PrototypeBanner />
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <SiteNav activePage="" />
  <TechnologyExplainer explainer={explainer} directory={technologyDirectory} />
  <SiteFooter />
  <CookieConsent />
</BaseLayout>

<script src="../../scripts/enhance.ts"></script>
