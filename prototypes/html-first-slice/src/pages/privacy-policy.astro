---
// Port of pages-v2/PrivacyPolicyPageV2.tsx. "Last updated" is a fixed date: the
// last change to the policy wording. Update it whenever the wording changes
// (the React page shows its build month instead).
// Difference: the closing button uses ink text on the accent colour (the React
// white-on-accent pair is 3.6:1).
import StandaloneShell from '../layouts/StandaloneShell.astro';

const updated = '29 October 2026';
const seo = { path: '/privacy-policy', title: 'Privacy Policy', description: 'How Fresh Tech protects your data. GDPR and data protection information.', type: 'article' };
---

<StandaloneShell name="privacy-policy" seo={seo}>
  <section class="sa-hero">
    <div class="sa-wrap" style="--sa-max: 800px">
      <p class="sa-eyebrow sa-eyebrow-light">Privacy</p>
      <h1 class="sa-display sa-display-light" style="--sa-size: 48px; --sa-size-mobile: 38px; margin-bottom: 16px">Your data, protected.</h1>
      <p class="sa-lead" style="margin: 0">Last updated: {updated}</p>
    </div>
  </section>

  <section class="sa-section sa-paper">
    <div class="sa-wrap sa-prose" style="--sa-max: 760px">
      <div class="sa-block">
        <h2>1. Who we are</h2>
        <p>We are FRESH PCS CONSULTANCY LTD trading as Fresh Tech ("we", "us", "our"). Our company registration number is 09296207 and our ICO registration is ZA136732. Our registered address is 28 Livesey Avenue, Ludlow, SY8 1HN.</p>
      </div>
      <div class="sa-block">
        <h2>2. Data we collect</h2>
        <p>We may collect the following information:</p>
        <ul>
          <li>Name and job title.</li>
          <li>Contact information including email address and telephone number.</li>
          <li>Demographic information such as postcode, preferences and interests.</li>
          <li>Technical data including IP addresses and browser type when you visit our website.</li>
        </ul>
      </div>
      <div class="sa-block">
        <h2>3. How we use your data</h2>
        <p>We need this information to understand your needs and provide a better service, specifically for:</p>
        <ul>
          <li>Internal record keeping.</li>
          <li>Improving our products and services.</li>
          <li>Sending promotional emails about new services or special offers (opt-out any time).</li>
          <li>Responding to your enquiries submitted via our contact forms.</li>
        </ul>
      </div>
      <div class="sa-block">
        <h2>4. Who we share it with</h2>
        <p>When you send a message through our website, it is delivered to our inbox by SMTP2GO, an email delivery service using servers in the UK and EU, and our website is hosted by 20i in the United Kingdom. Both act only on our instructions under a data processing agreement. We do not share your details with anyone else unless you ask us to or the law requires it.</p>
      </div>
      <div class="sa-block">
        <h2>5. Security</h2>
        <p>We are committed to ensuring your information is secure. To prevent unauthorised access or disclosure, we have put in place suitable physical, electronic and managerial procedures to safeguard and secure the information we collect online. As an IT security company, we practice what we preach.</p>
      </div>
      <div class="sa-block">
        <h2>6. Cookies</h2>
        <p>A cookie is a small file stored in your browser. The only non-essential cookies we use are anonymous analytics, and they do not load unless you opt in via our cookie banner. We use this information purely for statistical analysis to improve the website, never for advertising, and we never sell your data. For the full breakdown and to change your choice at any time, see our <a href="/cookie-policy">cookie policy</a>.</p>
      </div>
      <div class="sa-block">
        <h2>7. Controlling your personal information</h2>
        <p>You may choose to restrict the collection or use of your personal information. If you have previously agreed to us using your data for direct marketing, you may change your mind at any time by writing to or emailing us at <a href="mailto:hello@fresh-tech.uk">hello@fresh-tech.uk</a>.</p>
        <p>We will not sell, distribute or lease your personal information to third parties unless we have your permission or are required by law to do so.</p>
      </div>
      <div class="sa-note">Questions about your data? Email <a href="mailto:hello@fresh-tech.uk">hello@fresh-tech.uk</a> or call <a href="tel:+441584517234">01584 517 234</a>.</div>
    </div>
  </section>

  <section class="sa-section sa-deep sa-rule">
    <div class="sa-wrap sa-center" style="--sa-max: 720px">
      <h2 class="sa-display" style="--sa-size: 32px; margin-bottom: 14px">Any questions?</h2>
      <a class="sa-button" href="/contact">Get in touch →</a>
    </div>
  </section>
</StandaloneShell>
