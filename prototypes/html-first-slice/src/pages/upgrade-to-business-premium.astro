  <section class="sa-section sa-white">
    <div class="sa-wrap sa-center" style="--sa-max: 1000px">
      <h2 class="bp-h2">The Upgrade Path</h2>
      <p class="bp-lede">Moving to Business Premium and enrolling devices is straightforward. Here's what to expect.</p>
    </div>
    <div class="sa-wrap bp-steps" style="--sa-max: 1000px">
      <div class="bp-step">
        <span class="bp-step-num">1</span>
        <h3>License Upgrade</h3>
        <p>We upgrade your Microsoft 365 licenses from Standard to Premium. Takes effect immediately.</p>
      </div>
      <div class="bp-step">
        <span class="bp-step-num">2</span>
        <h3>Configure Intune</h3>
        <p>We deploy our tested security templates -policies for encryption, updates, OneDrive, and more.</p>
      </div>
      <div class="bp-step">
        <span class="bp-step-num">3</span>
        <h3>Enroll Devices</h3>
        <p>Existing devices enroll during a scheduled rollout. New devices auto-enroll via Autopilot.</p>
      </div>
      <div class="bp-step">
        <span class="bp-step-num">4</span>
        <h3>Protected &amp; Visible</h3>
        <p>You now have a dashboard showing every device, its compliance status, and the power to act.</p>
      </div>
    </div>
    <div class="sa-wrap" style="--sa-max: 1000px">
      <div class="bp-timeline">
        <h3>Typical Timeline</h3>
        <p>For most SMBs (10-50 users), the complete process takes <strong>1-2 weeks</strong> from license upgrade to all devices enrolled. Users experience minimal disruption -most of the work happens silently in the background.</p>
      </div>
    </div>
  </section>

  <section class="sa-section sa-deep">
    <div class="sa-wrap sa-center" style="--sa-max: 800px">
      <h2 class="bp-h2">Frequently Asked Questions</h2>
      <p class="bp-body">Common questions about upgrading and device enrollment</p>
    </div>
    <div class="sa-wrap bp-accordion-list" style="--sa-max: 800px">
      {faqs.map(faq => (
        <details class="bp-accordion bp-faq">
          <summary>
            <span>{faq.q}</span>
            <span class="bp-chevron" aria-hidden="true"></span>
          </summary>
          <div class="bp-accordion-body">
            <p set:html={faqHtml(faq.a)} />
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="sa-section sa-ink sa-center">
    <div class="sa-wrap" style="--sa-max: 800px">
      <h2 class="bp-h2 bp-h2-light">Ready to Take Control?</h2>
      <p class="bp-cta-lede">Stop wondering which devices are accessing your data and whether they're secure. Let's get your devices enrolled and protected.</p>
      <div class="bp-cta-actions">
        <a class="sa-button" href="/contact">Discuss Your Upgrade</a>
        <a class="sa-button sa-button-dark" href="/it-health-check">Take Our IT Health Check</a>
      </div>
    </div>
  </section>

  <section class="sa-section sa-paper">
    <div class="sa-wrap sa-center" style="--sa-max: 1000px">
      <h2 class="bp-h2">Related Reading</h2>
      <div class="bp-related-grid">
        <a class="bp-related-card" href="/microsoft-business-premium">
          <h3>Why Business Premium?</h3>
          <p>Feature comparison and cost analysis.</p>
        </a>
        <a class="bp-related-card" href="/technology/intune-autopilot">
          <h3>Intune &amp; Autopilot Explained</h3>
          <p>Technical deep-dive into device management.</p>
        </a>
        <a class="bp-related-card" href="/cloud-backup-necessity">
          <h3>Cloud Backup Myth</h3>
          <p>Why OneDrive sync isn't backup.</p>
        </a>
      </div>
      <p class="bp-browse-all">
        <a class="sa-link" href="/resources">Browse all resources <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <SourceContact />
</StandaloneShell>

<script>
  document.querySelectorAll('[data-goto-contact]').forEach(button => {
    button.addEventListener('click', () => { window.location.href = '/contact'; });
  });

  // Port of components/LicenseComparator.tsx's currentPlan toggle and derived
  // figures (same PRICES and toFixed(2) rounding). Default stays Standard so
  // the static baseline is unchanged; the buttons only update the DOM.
  const PRICES = { basic: 4.90, standard: 10.30, premium: 18.10, security_stack: 15.00 };
  const comparator = document.querySelector<HTMLElement>('[data-license-comparator]');
  if (comparator) {
    const buttons = [...comparator.querySelectorAll<HTMLButtonElement>('button[data-plan]')];
    const nameEl = document.querySelector<HTMLElement>('[data-current-name]');
    const priceEl = document.querySelector<HTMLElement>('[data-current-price]');
    const desktopApps = document.querySelector<HTMLElement>('[data-desktop-apps]');
    const gapEl = document.querySelector<HTMLElement>('[data-plan-gap]');
    const savingsEl = document.querySelector<HTMLElement>('[data-plan-savings]');

    const update = (plan: 'basic' | 'standard') => {
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.plan === plan)));
      const price = PRICES[plan];
      if (nameEl) nameEl.textContent = `Microsoft 365 ${plan === 'basic' ? 'Basic' : 'Standard'}`;
      if (priceEl) priceEl.textContent = `£${price.toFixed(2)}`;
      if (desktopApps) desktopApps.hidden = plan !== 'standard';
      const gap = (PRICES.premium - price).toFixed(2);
      const savings = (price + PRICES.security_stack - PRICES.premium).toFixed(2);
      if (gapEl) gapEl.textContent = `Difference: Only £${gap} / month`;
      if (savingsEl) savingsEl.textContent = `Upgrading saves you approx £${savings} per user vs buying separate tools!`;
    };

    buttons.forEach(button => button.addEventListener('click', () => update(button.dataset.plan as 'basic' | 'standard')));
  }
</script>

