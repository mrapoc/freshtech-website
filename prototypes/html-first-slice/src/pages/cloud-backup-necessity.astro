---
// Port of pages/CloudBackupNecessityPage.tsx. Two useState accordion groups
// (FAQs and real-world scenarios) become native <details name="..."> so at
// most one item per group is open at a time, same as the source's single
// openFaq/openScenario state, and both work without JavaScript. Because the
// source only renders an accordion's body once opened (conditional React
// render), the production baseline never contains that body text; our
// always-in-markup <details> body does, so the extra scenario "Without/With
// Independent Backup" sub-headings and every scenario/FAQ body sentence are
// documented as differences in standalone-differences.mjs (key
// '/cloud-backup-necessity'). The FAQ answers use the source's ** / * inline
// markdown, rendered here with the same split logic as the React component.
// The hero image is a genuine Cloudinary asset; the captured production
// baseline shows the SmartImage onError fallback (placehold.co) because that
// capture run could not reach Cloudinary, so the real asset path is restored
// via a documented image difference rather than reproduced literally.
import StandaloneShell from '../layouts/StandaloneShell.astro';
import SourceContact from '../components/SourceContact.astro';

const renderMarkup = (text: string) =>
  text
    .split(/(\*\*[^*]+\*\*)/g)
    .map(part =>
      part.startsWith('**') && part.endsWith('**')
        ? `<strong>${part.slice(2, -2)}</strong>`
        : part
            .split(/(\*[^*]+?\*)/g)
            .map(sub => (sub.startsWith('*') && sub.endsWith('*') && sub.length > 2 ? `<em>${sub.slice(1, -1)}</em>` : sub))
            .join('')
    )
    .join('');

const scenarios = [
  {
    title: 'The Accidental Deletion',
    story: "Sarah, an office manager, accidentally deleted a SharePoint folder containing 3 years of client contracts while reorganising files. She didn't notice for 6 weeks.",
    withoutBackup: "The files exceeded the 93-day retention window. They were permanently gone. The business had to contact clients to request copies of their own contracts -embarrassing and time-consuming.",
    withBackup: "A quick restore from the backup solution brought back the entire folder within minutes. The business didn't even need to inform clients.",
    lesson: "Microsoft 365's recycle bin only retains deleted items for 93 days. After that, it's gone forever -unless you have independent backup.",
  },
  {
    title: 'The Disgruntled Leaver',
    story: "James, a sales manager, resigned with immediate effect after a disagreement. Before handing over his laptop, he logged into OneDrive and permanently deleted his entire sales pipeline, contacts, and 2 years of proposal documents.",
    withoutBackup: "The deletion was discovered a week later when his replacement started. Microsoft's retention had already cleared the recycle bin. The new hire spent months rebuilding relationships from scratch.",
    withBackup: "The IT team restored James's entire OneDrive to the state it was in before his departure. The new sales manager hit the ground running.",
    lesson: "When employees leave unhappily, your data is at risk. Microsoft won't protect you from authorised users deleting their own files.",
  },
  {
    title: 'The Ransomware Sync',
    story: "A manufacturing firm's accountant opened a malicious email attachment. Ransomware encrypted her local files -and because OneDrive was syncing, the encrypted versions replaced the good copies in the cloud.",
    withoutBackup: "The 'cloud backup' everyone assumed existed was just OneDrive sync. The encrypted files were now in the cloud too. They paid a £45,000 ransom and still lost 3 months of data.",
    withBackup: "The backup solution stored immutable copies that ransomware couldn't touch. Full restore completed in 4 hours. Zero ransom paid.",
    lesson: "OneDrive sync is not backup -it replicates problems as fast as it replicates files. See our guide on ransomware recovery.",
  },
  {
    title: 'The Retention Gap',
    story: "A law firm needed to retrieve emails from 18 months ago for a court case. The emails had been deleted by the user after the matter 'closed'.",
    withoutBackup: "Microsoft 365's default retention is 30 days for deleted items. Even with litigation hold enabled (which they hadn't configured), the emails were unrecoverable.",
    withBackup: "The backup solution retained all emails for 7 years as per their configured policy. The evidence was produced within the hour.",
    lesson: "Legal and compliance requirements often exceed Microsoft's default retention. Without independent backup, you may fail regulatory obligations.",
  },
  {
    title: 'The Account Compromise',
    story: "A hacker gained access to the finance director's Microsoft 365 account through a phishing email. They set up email forwarding rules and deleted evidence of fraudulent payment requests over several weeks.",
    withoutBackup: "By the time the breach was discovered, the deleted emails had aged out of retention. There was no audit trail of what had been sent or deleted.",
    withBackup: "The backup retained a complete timeline. Investigators could see exactly which emails were forwarded, deleted, and when -crucial evidence for the fraud investigation.",
    lesson: "Attackers don't just steal data -they cover their tracks. Independent backup preserves the evidence chain.",
  },
];

const faqs = [
  {
    q: "Isn't my data already backed up because it's 'in the cloud'?",
    a: "No -and this is the most dangerous assumption businesses make. Cloud services like Microsoft 365 and Google Workspace provide **high availability** (your data is replicated across data centres so the service stays online), but this is not backup. If you delete a file, that deletion is replicated everywhere. If ransomware encrypts your files via sync, the encrypted versions replace the originals. The cloud protects against *their* hardware failures, not *your* data loss.",
  },
  {
    q: "What's the difference between OneDrive sync and OneDrive backup?",
    a: "**OneDrive Sync** mirrors files between your computer and the cloud -changes go both ways instantly. **OneDrive Backup (Known Folder Move)** redirects your Desktop, Documents, and Pictures folders to OneDrive. Both are sync technologies, not backup. A true backup is a separate, protected copy of your data that can be restored to a point in time -even if the original is deleted, corrupted, or encrypted.",
  },
  {
    q: 'What is Known Folder Move (KFM) and should we use it?',
    a: "KFM is a Microsoft feature that redirects your Desktop, Documents, and Pictures folders to OneDrive. **You absolutely should use it** -it means files aren't trapped on individual laptops and are accessible from anywhere. But it's protection against *device loss*, not data loss. If a file is deleted from OneDrive, it's deleted everywhere. KFM + independent backup = comprehensive protection.",
  },
  {
    q: 'How long does Microsoft keep deleted files?',
    a: "It varies by service: **OneDrive/SharePoint** keeps deleted items in the recycle bin for 93 days, then they're permanently deleted. **Exchange Online** keeps deleted emails for 14-30 days depending on configuration. **Teams** messages follow complex retention rules. After these windows close, Microsoft cannot recover your data -even if you pay them. These retention periods are also not guaranteed and can change.",
  },
  {
    q: 'What about Google Workspace -is it the same problem?',
    a: "Yes. Google's Terms of Service contain nearly identical disclaimers. Google Drive's trash empties after 30 days. Gmail deleted items last 30 days. Google explicitly states they are not responsible for data loss. The 'it's in the cloud' false sense of security applies equally to Google Workspace users.",
  },
  {
    q: 'How much does proper cloud backup cost?',
    a: "Typically £2-4 per user per month for comprehensive Microsoft 365 or Google Workspace backup. Compare this to the cost of losing your data: the average cost of a ransomware attack for SMBs is £115,000. For a 20-person company, that's roughly £50/month for insurance against potentially business-ending data loss.",
  },
  {
    q: "Can't I just export my data regularly instead?",
    a: "Manual exports are better than nothing, but they're not practical at scale. They require someone to remember, they're incomplete (you rarely get everything), they're not easily restorable, and they're typically stored somewhere that's also vulnerable to the same threats. Automated, managed backup with tested restores is the only reliable approach.",
  },
  {
    q: "We have Microsoft 365 E5 -doesn't that include backup?",
    a: "No. Even the most expensive Microsoft 365 licence does not include true backup. E5 includes advanced compliance features like extended retention and litigation hold, but these are not the same as backup. Retention policies keep data longer before deletion -but if data is corrupted or encrypted, that corrupted version is what's retained. Microsoft is now offering 'Microsoft 365 Backup' as an additional paid product, acknowledging that backup was never included.",
  },
];

// Verbatim from the source's articleSchema / faqSchema (the FAQ schema strips
// only ** markers, keeping single asterisks, per the source's regex).
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Why Microsoft 365 and Google Workspace Need Backing Up',
  description: "The cloud doesn't back up your data. Microsoft and Google's own terms of service make this clear. Learn why independent backup is essential for business continuity.",
  author: { '@type': 'Organization', name: 'Fresh Tech', url: 'https://fresh-tech.uk' },
  publisher: {
    '@type': 'Organization',
    name: 'Fresh Tech',
    logo: { '@type': 'ImageObject', url: 'https://res.cloudinary.com/djkmeg5se/image/upload/f_auto,q_auto/fresh-tech-logo.png' },
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/\*\*([^*]+)\*\*/g, '$1') } })),
};

const seo = {
  path: '/cloud-backup-necessity',
  title: 'Why Microsoft 365 & Google Workspace Need Backing Up | The Cloud Backup Myth',
  description: "Microsoft and Google explicitly state they're not responsible for your data loss. Learn why cloud services need independent backup, with real examples and expert guidance.",
  breadcrumbs: [
    { name: 'Resources', item: '/resources' },
    { name: 'Why Cloud Backup is Essential', item: '/cloud-backup-necessity' },
  ],
  schema: [articleSchema, faqSchema],
};

// Small decorative icon set. All markup here is inside <svg>, which the
// parity checker skips entirely, so shapes are simplified placeholders for
// the source's lucide-react icons rather than pixel-identical copies.
const ico = (path: string, size = 22) =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${path}</svg>`;
const ICON = {
  check: ico('<path d="M20 6 9 17l-5-5"/>'),
  cross: ico('<path d="M18 6 6 18M6 6l12 12"/>'),
  warning: ico('<path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/>'),
  arrow: ico('<path d="M5 12h14M13 6l6 6-6 6"/>', 16),
  quote: ico('<path d="M7 7h5v5c0 3-2 5-5 5"/><path d="M15 7h5v5c0 3-2 5-5 5"/>', 24),
  dot: ico('<circle cx="12" cy="12" r="8"/>'),
};
const chevron = '<svg class="cbn-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>';
---

<StandaloneShell name="cloud-backup-necessity" seo={seo}>
  <section class="sa-hero">
    <div class="sa-wrap sa-center" style="--sa-max: 800px">
      <span class="cbn-badge">Back Up</span>
      <h1 class="sa-display sa-display-light" style="--sa-size: 44px; --sa-size-mobile: 32px; margin: 16px 0">The Cloud Doesn't Back Up Your Data</h1>
      <p class="sa-lead" style="margin: 0 auto">Microsoft and Google explicitly say so in their terms of service. Most businesses don't discover this until it's too late.</p>
    </div>
  </section>

  <nav class="cbn-crumbs" aria-label="Breadcrumb">
    <div class="sa-wrap sa-center" style="--sa-max: 800px">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/resources">Resources</a></li>
        <li><span aria-current="page">Why Cloud Backup is Essential</span></li>
      </ol>
    </div>
  </nav>

  <section class="sa-section sa-paper">
    <div class="sa-wrap">
      <div class="cbn-hero-grid">
        <div>
          <p class="cbn-eyebrow"><span set:html={ICON.dot} /> Essential Guide</p>
          <h2 class="sa-display" style="--sa-size: 30px; margin-bottom: 14px">The Shared Responsibility Model</h2>
          <p class="cbn-body">Microsoft and Google operate under a "shared responsibility" model. They protect the infrastructure -you protect your data. This guide explains what that means in practice and how to ensure your business data is truly protected.</p>
          <div class="cbn-pill-row">
            <span class="cbn-pill cbn-pill-blue"><span set:html={ICON.dot} /> Microsoft 365</span>
            <span class="cbn-pill cbn-pill-green"><span set:html={ICON.dot} /> Google Workspace</span>
            <span class="cbn-pill cbn-pill-purple"><span set:html={ICON.dot} /> OneDrive KFM</span>
          </div>
        </div>
        <div>
          <img
            src="https://res.cloudinary.com/djkmeg5se/image/upload/w_600,f_auto,q_auto/v1749314205/cloud-backup-data-protection-microsoft-365.jpg"
            srcset="https://res.cloudinary.com/djkmeg5se/image/upload/w_600,f_auto,q_auto/v1749314205/cloud-backup-data-protection-microsoft-365.jpg 600w, https://res.cloudinary.com/djkmeg5se/image/upload/w_1200,f_auto,q_auto/v1749314205/cloud-backup-data-protection-microsoft-365.jpg 1200w"
            sizes="(min-width: 768px) 45vw, calc(100vw - 40px)"
            alt="Cloud backup and data protection for Microsoft 365 and Google Workspace"
            width="600"
            height="400"
            fetchpriority="high"
            class="cbn-hero-image"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="sa-section sa-white">
    <div class="sa-wrap sa-center" style="--sa-max: 800px">
      <span class="cbn-icon-circle cbn-icon-danger"><span set:html={ICON.warning} /></span>
      <h2 class="sa-display" style="--sa-size: 32px; margin: 18px 0 14px">The Uncomfortable Truth</h2>
      <p class="cbn-lead-dark">Most businesses believe their data is safe because it's "in the cloud". Microsoft and Google's own legal terms tell a different story.</p>
    </div>
    <div class="sa-wrap" style="--sa-max: 800px; margin-top: 32px">
      <div class="cbn-quote-block cbn-quote-blue">
        <span set:html={ICON.quote} />
        <div>
          <p class="cbn-quote-text">"We recommend that you regularly backup Your Content and Data that you store on the Services or store using Third-Party Apps and Services."</p>
          <p class="cbn-quote-text">"We strive to keep the Services up and running; however, all online services suffer occasional disruptions and outages, and Microsoft is not liable for any disruption or loss you may suffer as a result."</p>
          <p class="cbn-quote-attribution"> - Microsoft Services Agreement, Section 6(b)</p>
          <a href="https://www.microsoft.com/en-us/servicesagreement" target="_blank" rel="noopener noreferrer" class="cbn-quote-link">View current Microsoft Services Agreement →</a>
        </div>
      </div>
      <div class="cbn-quote-block cbn-quote-green">
        <span set:html={ICON.quote} />
        <div>
          <p class="cbn-quote-text">"When permitted by law, Google, and Google's suppliers and distributors, will not be responsible for lost profits, revenues, or data, financial losses or indirect, special, consequential, exemplary, or punitive damages."</p>
          <p class="cbn-quote-text">"Google does not make any commitments about the content within the services, the specific functions of the services, or their reliability, availability, or ability to meet your needs."</p>
          <p class="cbn-quote-attribution"> - Google Workspace Terms of Service</p>
          <a href="https://workspace.google.com/terms/user_features.html" target="_blank" rel="noopener noreferrer" class="cbn-quote-link">View current Google Workspace Terms →</a>
        </div>
      </div>
      <p class="cbn-summary-line">In plain English: <strong>if your data is lost, corrupted, or deleted -that's your problem, not theirs.</strong></p>
    </div>
  </section>

  <section class="sa-section sa-deep">
    <div class="sa-wrap">
      <h2 class="sa-display sa-center" style="--sa-size: 30px; margin-bottom: 12px">What Cloud Services Actually Provide</h2>
      <p class="cbn-body sa-center cbn-intro">Understanding the difference between high availability and backup is critical.</p>
      <div class="cbn-two-col">
        <div class="cbn-card">
          <h3 class="cbn-card-heading cbn-heading-good"><span set:html={ICON.check} /> What They DO Provide</h3>
          <ul class="cbn-tick-list cbn-tick-good">
            <li><span set:html={ICON.check} /><span><strong>High Availability</strong><br />Data replicated across multiple data centres so the service stays online</span></li>
            <li><span set:html={ICON.check} /><span><strong>Infrastructure Redundancy</strong><br />Protection against their hardware failures, power outages, and natural disasters at their facilities</span></li>
            <li><span set:html={ICON.check} /><span><strong>Limited Retention</strong><br />Recycle bin and version history for a limited window (typically 30-93 days)</span></li>
            <li><span set:html={ICON.check} /><span><strong>Physical Security</strong><br />Data centres are secure, climate-controlled, and access-restricted</span></li>
          </ul>
        </div>
        <div class="cbn-card cbn-card-danger-border">
          <h3 class="cbn-card-heading cbn-heading-bad"><span set:html={ICON.cross} /> What They DON'T Provide</h3>
          <ul class="cbn-tick-list cbn-tick-bad">
            <li><span set:html={ICON.cross} /><span><strong>Protection from User Deletion</strong><br />If you or your staff delete files (accidentally or deliberately), that's replicated everywhere</span></li>
            <li><span set:html={ICON.cross} /><span><strong>Ransomware Protection</strong><br />Encrypted files sync to the cloud as fast as healthy ones -your "backup" becomes encrypted too</span></li>
            <li><span set:html={ICON.cross} /><span><strong>Long-Term Retention</strong><br />Once retention windows close (30-93 days), data is permanently unrecoverable</span></li>
            <li><span set:html={ICON.cross} /><span><strong>Point-in-Time Recovery</strong><br />You can't restore your entire tenant to how it was 6 months ago</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sa-section sa-white">
    <div class="sa-wrap">
      <h2 class="sa-display sa-center" style="--sa-size: 30px; margin-bottom: 28px"><span set:html={ICON.dot} /> Understanding OneDrive "Backup"</h2>

      <div class="cbn-panel cbn-panel-blue">
        <h3 class="cbn-panel-heading">What is Known Folder Move (KFM)?</h3>
        <p class="cbn-body">When you enable "Backup" in OneDrive settings, you're actually enabling <strong>Known Folder Move</strong>. This redirects your Desktop, Documents, and Pictures folders so they sync to OneDrive instead of staying on your local hard drive.</p>
        <div class="cbn-two-col">
          <div class="cbn-subcard">
            <h4 class="cbn-subheading cbn-heading-good"><span set:html={ICON.check} /> KFM is Excellent For:</h4>
            <ul class="cbn-bullet-list">
              <li>• Protecting against laptop loss or theft</li>
              <li>• Accessing files from any device</li>
              <li>• Preventing files being "trapped" on one computer</li>
              <li>• Making device replacement painless</li>
              <li>• Ensuring remote workers' files are centralised</li>
            </ul>
          </div>
          <div class="cbn-subcard">
            <h4 class="cbn-subheading cbn-heading-bad"><span set:html={ICON.cross} /> KFM Does NOT Protect Against:</h4>
            <ul class="cbn-bullet-list">
              <li>• Accidental or malicious file deletion</li>
              <li>• Ransomware encrypting synced files</li>
              <li>• Data corruption replicating to the cloud</li>
              <li>• Account compromise and data destruction</li>
              <li>• Retention windows expiring</li>
            </ul>
          </div>
        </div>
        <div class="cbn-callout">
          <p><span set:html={ICON.warning} /> <strong>Key Insight:</strong> KFM is <em>sync</em>, not <em>backup</em>. It replicates changes in both directions -including deletions and corruptions. You should absolutely use KFM, but you also need independent backup.</p>
        </div>
      </div>

      <div class="cbn-panel cbn-panel-paper">
        <h3 class="cbn-panel-heading"><span set:html={ICON.dot} /> How We Enable This Automatically</h3>
        <p class="cbn-body">For businesses using <a class="sa-link" href="/microsoft-business-premium">Microsoft 365 Business Premium</a>, we configure <a class="sa-link" href="/technology/intune-autopilot">Intune</a> to automatically enable Known Folder Move on every enrolled device. No manual setup required -it just works.</p>
        <div class="cbn-three-col">
          <div class="cbn-mini-card">
            <span set:html={ICON.dot} />
            <h4 class="cbn-subheading">Automatic Enrollment</h4>
            <p class="cbn-small">New devices automatically join Intune when users sign in with their work account</p>
          </div>
          <div class="cbn-mini-card">
            <span set:html={ICON.dot} />
            <h4 class="cbn-subheading">Policy-Driven KFM</h4>
            <p class="cbn-small">Intune policies silently enable KFM -users don't need to do anything</p>
          </div>
          <div class="cbn-mini-card">
            <span set:html={ICON.dot} />
            <h4 class="cbn-subheading">No More "Local Only" Files</h4>
            <p class="cbn-small">Eliminates files scattered across individual laptops that never get backed up</p>
          </div>
        </div>
        <div class="cbn-button-row sa-center">
          <a class="sa-button sa-button-dark" href="/technology/intune-autopilot">Learn about Intune &amp; Autopilot <span set:html={ICON.arrow} /></a>
          <a class="sa-button" href="/microsoft-business-premium">Why Business Premium? <span set:html={ICON.arrow} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="sa-section sa-deep">
    <div class="sa-wrap" style="--sa-max: 900px">
      <div class="sa-center" style="margin-bottom: 24px">
        <h2 class="sa-display" style="--sa-size: 30px; margin-bottom: 10px">Real-World Scenarios</h2>
        <p class="cbn-body">These situations happen every day. The difference between disaster and minor inconvenience is backup.</p>
      </div>
      <div class="cbn-accordion-list">
        {scenarios.map(scenario => (
          <details name="cbn-scenario" class="cbn-accordion">
            <summary>
              <span class="cbn-accordion-title"><span set:html={ICON.dot} /> {scenario.title}</span>
              <span set:html={chevron} />
            </summary>
            <div class="cbn-accordion-body">
              <p class="cbn-story">{scenario.story}</p>
              <div class="cbn-two-col">
                <div class="cbn-mini-panel cbn-mini-panel-bad">
                  <h3 class="cbn-heading-bad"><span set:html={ICON.cross} /> Without Independent Backup</h3>
                  <p class="cbn-small">{scenario.withoutBackup}</p>
                </div>
                <div class="cbn-mini-panel cbn-mini-panel-good">
                  <h3 class="cbn-heading-good"><span set:html={ICON.check} /> With Independent Backup</h3>
                  <p class="cbn-small">{scenario.withBackup}</p>
                </div>
              </div>
              <div class="cbn-lesson">
                <p><strong>Lesson:</strong> {scenario.lesson}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="sa-section sa-white">
    <div class="sa-wrap">
      <h2 class="sa-display sa-center" style="--sa-size: 30px; margin-bottom: 32px">The Real Cost Comparison</h2>
      <div class="cbn-two-col">
        <div class="cbn-card cbn-card-bad">
          <h3 class="cbn-card-heading cbn-heading-bad sa-center"><span set:html={ICON.warning} /> Without Independent Backup</h3>
          <ul class="cbn-tick-list cbn-tick-bad">
            <li><span set:html={ICON.cross} /><span>Average ransomware cost for SMBs: <strong>£115,000</strong></span></li>
            <li><span set:html={ICON.cross} /><span>Average downtime after data loss: <strong>21 days</strong></span></li>
            <li><span set:html={ICON.cross} /><span>60% of SMBs close within 6 months of major data loss</span></li>
            <li><span set:html={ICON.cross} /><span>Regulatory fines for losing customer data</span></li>
            <li><span set:html={ICON.cross} /><span>Reputational damage and lost client trust</span></li>
            <li><span set:html={ICON.cross} /><span>Staff productivity loss rebuilding lost work</span></li>
          </ul>
        </div>
        <div class="cbn-card cbn-card-good">
          <h3 class="cbn-card-heading cbn-heading-good sa-center"><span set:html={ICON.dot} /> With Independent Backup</h3>
          <ul class="cbn-tick-list cbn-tick-good">
            <li><span set:html={ICON.check} /><span>Typical cost: <strong>£2-4 per user/month</strong></span></li>
            <li><span set:html={ICON.check} /><span>Recovery time measured in <strong>hours, not weeks</strong></span></li>
            <li><span set:html={ICON.check} /><span>Point-in-time restore to any date</span></li>
            <li><span set:html={ICON.check} /><span>Immutable backups ransomware can't touch</span></li>
            <li><span set:html={ICON.check} /><span>Compliance with data retention requirements</span></li>
            <li><span set:html={ICON.check} /><span>Peace of mind that data is truly protected</span></li>
          </ul>
        </div>
      </div>
      <p class="cbn-body sa-center cbn-cost-line">For a 20-person company, comprehensive cloud backup costs roughly <strong>£50-80/month</strong>. That's the price of one team lunch to protect against potentially business-ending data loss.</p>
    </div>
  </section>

  <section class="sa-section sa-deep">
    <div class="sa-wrap">
      <h2 class="sa-display sa-center" style="--sa-size: 30px; margin-bottom: 10px">The Complete Protection Stack</h2>
