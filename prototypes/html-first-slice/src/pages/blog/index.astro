---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogListing from '../../components/BlogListing.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteNav from '../../components/SiteNav.astro';
import { blogPosts } from '../../generated/blog-data.mjs';
import { listingSeo } from '../../lib/blog-seo.mjs';
import '../../styles/blog.css';
import PrototypeBanner from '../../components/PrototypeBanner.astro';

const seo = listingSeo();
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} ogType={seo.ogType} schemas={seo.schemas} robots={seo.robots} preloadFonts={['/fonts/bungee-latin.woff2']}>
  <PrototypeBanner />
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <SiteNav activePage="Blog" />
  <BlogListing posts={blogPosts} />
  <SiteFooter />
  <CookieConsent />
</BaseLayout>

<script src="../../scripts/enhance.ts"></script>
<script src="../../scripts/blog-filters.ts"></script>
