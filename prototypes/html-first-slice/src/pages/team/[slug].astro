---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteNav from '../../components/SiteNav.astro';
import TeamPage from '../../components/TeamPage.astro';
import { blogPosts } from '../../generated/blog-data.mjs';
import { teamMembers } from '../../generated/team-data.mjs';
import { teamSeo } from '../../lib/team-seo.mjs';
import '../../styles/team.css';
import PrototypeBanner from '../../components/PrototypeBanner.astro';

export function getStaticPaths() {
  return teamMembers.map(member => ({ params: { slug: member.slug }, props: { member } }));
}

const { member } = Astro.props;
// Preview keeps BaseLayout's noindex default; `robots` is deliberately not passed.
const seo = teamSeo(member);
const headingFontPreloads = /[Ā-ỿⱠ-ꟿ]/u.test(member.name)
  ? ['/fonts/bungee-latin.woff2', '/fonts/bungee-latin-ext.woff2']
  : ['/fonts/bungee-latin.woff2'];
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} ogType={seo.ogType} schemas={seo.schemas} preloadFonts={headingFontPreloads} pageFamily="team">
  <PrototypeBanner />
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <SiteNav activePage="" />
  <TeamPage member={member} posts={blogPosts} />
  <SiteFooter />
  <CookieConsent />
</BaseLayout>

<script src="../../scripts/enhance.ts"></script>
