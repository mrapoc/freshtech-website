---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import ServicePage from '../../components/ServicePage.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { services } from '../../generated/services-data.mjs';
import { serviceSeo } from '../../lib/service-seo.mjs';
import '../../styles/services.css';
import PrototypeBanner from '../../components/PrototypeBanner.astro';

export function getStaticPaths() {
  return services.map(service => ({ params: { slug: service.page.slug }, props: { service } }));
}

const { service } = Astro.props;
const seo = serviceSeo(service.page);
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} schemas={seo.schemas} robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <PrototypeBanner />
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <SiteNav activePage="Services" />
  <ServicePage service={service} />
  <SiteFooter />
  <CookieConsent />
</BaseLayout>

<script src="../../scripts/enhance.ts"></script>
