---
// Careers advert for the IT Support Engineer (2nd Line) role. This page no
// longer ports pages-v2/CareersPageV2.tsx (the React page is the rollback
// reference only), so it is not in scripts/lib/standalone-routes.mjs and has
// no production-parity fixture. Facts come from src/lib/recruitment.mjs; the
// launch checklist is kept privately. While applications are open the page is
// the full advert; once closed it thanks applicants and keeps the role
// description, without pay, terms or any application route.
import StandaloneShell from '../layouts/StandaloneShell.astro';
import { RECRUITMENT, canAcceptApplications } from '../lib/recruitment.mjs';

const { roleTitle, salary, contract, applications, hiringTeam } = RECRUITMENT;
const applyOpen = canAcceptApplications(applications);

const seo = applyOpen ? {
  path: '/careers',
  title: 'IT Support Engineer (2nd Line): Careers at Fresh Tech',
  description: 'Join Fresh Tech as a home-based IT Support Engineer. £30,000 to £35,000, with client visits across Shropshire and north Herefordshire. Apply by email.',
  type: 'website',
  // Branded 1200x630 social card (replaces the generic site superhero image).
  // Generated by scripts/generate-careers-card.mjs; bump the version suffix
  // there and here together so social caches pick up a changed card.
  image: '/images/careers-hiring-20261016.png',
} : {
  path: '/careers',
  title: 'Careers at Fresh Tech: a growing IT support team',
  description: 'Fresh Tech is a growing IT support business based in Ludlow. Applications for our IT Support Engineer role have closed. Future roles will be posted here.',
  type: 'website',
};

const facts = applyOpen ? [
  { n: '£30k to £35k', l: 'A year, depending on experience' },
  { n: 'Permanent', l: '37.5 hours, Monday to Friday' },
  { n: 'Home-based', l: 'Occasional client visits and team meetups' },
] : [
  { n: 'Closed', l: `${roleTitle} applications` },
  { n: 'Home-based', l: 'Occasional client visits and team meetups' },
  { n: 'People decide', l: 'We do not use AI to score or rank candidates' },
];

const essentials = [
  'Solid Microsoft 365, Windows and networking fundamentals.',
  'Confident everyday 2nd line judgement: knowing what to try, when to stop, and when a problem needs a different approach.',
  'Clear, friendly communication with people who are not technical.',
  'You follow problems through and hand over clearly when someone else needs to help.',
  'Good notes. You write down what you found and what you changed so the next person can follow it.',
  'Asking for help when you are stuck, rather than guessing.',
  'A full driving licence valid for UK driving and a suitable car with business insurance for client visits. If you need an adjustment to any of this, tell us and we will discuss it.',
];

const useful = [
  'Working at a managed service provider.',
  'Intune and Entra ID.',
  'Backup and recovery products.',
];

const terms = [
  { label: 'Pay', value: `${salary}, depending on experience. Pay reflects your experience and independence within the role.` },
  { label: 'Contract', value: `${contract}. 37.5 hours a week, Monday to Friday, 9am to 5pm with a 30 minute unpaid lunch.` },
  { label: 'Holiday', value: '25 days a year plus England and Wales bank holidays.' },
  { label: 'Pension', value: 'Employer contribution of 3% of qualifying earnings.' },
  { label: 'Equipment', value: 'We provide a work laptop with a softphone for calls. We do not provide a work mobile. You can use Teams or the softphone on your personal phone if you prefer, but it is optional.' },
  { label: 'Training', value: 'Training we agree together is done in paid time.' },
  { label: 'Out of hours', value: 'No routine on-call. Occasional out of hours work is optional, agreed in advance and paid at 1.5 times your normal rate.' },
  { label: 'Travel', value: 'Business travel is working time. Mileage is paid at 55p a mile for the first 10,000 business miles in a tax year and 25p a mile after that, plus reasonable parking and tolls.' },
];

const process = [
  { title: 'Apply by email', desc: 'Send your CV to our recruitment mailbox with a few lines about where you are based and your notice period. No lengthy covering letter needed.' },
  { title: 'A person reads it', desc: `Sam receives your application and shares it with Matt in our restricted recruitment folder. We make every hiring decision ourselves. We do not use AI to score or rank candidates.` },
  { title: 'An initial conversation', desc: 'A short call to talk about the role, your experience and the travel involved from where you live.' },
  { title: 'A practical session', desc: 'Around 60 minutes on Microsoft Teams working through a fictional support scenario with us. You can use Google, documentation or AI tools as you would at work, as long as you verify what you find and can explain it. Neither side records, transcribes or uses AI note-takers.' },
  { title: 'Checks and offer', desc: "Any offer will be subject to references, right-to-work and relevant driving checks, plus a basic DBS check paid for by Fresh Tech. We'll arrange the DBS check after a conditional offer and consider any findings individually in relation to the role." },
];
---

<StandaloneShell name="careers" seo={seo}>
  <section class="sa-hero">
    <div class="sa-wrap careers-hero-grid" style="--sa-max: 1100px">
      <div>
        <p class="sa-eyebrow sa-eyebrow-light">Careers</p>
        {applyOpen ? (
          <Fragment>
            <h1 class="sa-display sa-display-light" style="--sa-size: 46px; --sa-size-mobile: 34px; margin-bottom: 20px; line-height: 1">{roleTitle}</h1>
            <p class="careers-lead">Fresh Tech is a small IT support business based in Ludlow. We're looking for an engineer to join Sam and Matt, help our customers and take a proper interest in getting things working well. You'll mainly work from home, with occasional client visits and team meetups.</p>
            <p class="careers-sub">You don't need to live in Ludlow. We welcome applications from across Shropshire, north Herefordshire and neighbouring areas where those journeys are practical. Roughly an hour from Ludlow is a useful guide. Tell us where you're based and we'll discuss the travel involved. Moving to the area by your start date is fine too.</p>
            <a class="sa-button" href={applications.listingUrl}>Email your application →</a>
          </Fragment>
        ) : (
          <Fragment>
            <h1 class="sa-display sa-display-light" style="--sa-size: 46px; --sa-size-mobile: 34px; margin-bottom: 20px; line-height: 1">Thank you for your interest</h1>
            <p class="careers-lead">Applications for our {roleTitle} role have now closed. Thank you to everyone who took the time to apply.</p>
            <p class="careers-sub">Fresh Tech is a small IT support business based in Ludlow, and we're growing. Below is what the role involved and what we looked for, so you can see how we work. When we next have a role, we'll advertise it on this page.</p>
            <a class="sa-button" href="/about">Meet the team →</a>
          </Fragment>
        )}
      </div>
      <div class="careers-stats">
        {facts.map(s => (
          <div class="careers-stat">
            <div class="careers-stat-n">{s.n}</div>
            <div class="careers-stat-l">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <section class="sa-section sa-paper sa-rule">
    <div class="sa-wrap careers-two-col" style="--sa-max: 1100px">
      <div>
        <p class="sa-eyebrow">The role</p>
        <h2 class="sa-display" style="--sa-size: 32px; margin-bottom: 20px">{applyOpen ? "What you'd be doing" : 'What the role involves'}</h2>
        <div class="careers-prose">
          <p>You'd be the person our customers talk to when something isn't working: Microsoft 365, Windows laptops and desktops, networks and the everyday problems small businesses run into. Most of it is done remotely from home. Some of it means going to see a customer in Shropshire or north Herefordshire.</p>
          <p>You'd own the problems you pick up, fix them properly, write up what you did and ask one of us when you need a second opinion. Now and then we meet up in Ludlow.</p>
        </div>
      </div>
      <div>
        <p class="sa-eyebrow">About you</p>
        <h2 class="sa-display" style="--sa-size: 32px; margin-bottom: 20px">{applyOpen ? "What we're looking for" : 'What we looked for'}</h2>
        <h3 class="careers-h3">Essential</h3>
        <ul class="careers-list">{essentials.map(item => <li>{item}</li>)}</ul>
        <h3 class="careers-h3">Useful, not required</h3>
        <ul class="careers-list">{useful.map(item => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  {applyOpen && <section class="sa-section sa-white sa-rule">
    <div class="sa-wrap" style="--sa-max: 1100px">
      <p class="sa-eyebrow">Pay and terms</p>
      <h2 class="sa-display" style="--sa-size: 32px; margin-bottom: 28px">The practical bits</h2>
      <dl class="careers-terms">
        {terms.map(t => (
          <div class="careers-term">
            <dt>{t.label}</dt>
            <dd>{t.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>}

  {applyOpen && <section id="apply" class="sa-section sa-deep sa-rule">
    <div class="sa-wrap" style="--sa-max: 1100px">
      <p class="sa-eyebrow">How we'll hire</p>
      <h2 class="sa-display" style="--sa-size: 32px; margin-bottom: 12px">How to apply and what happens next</h2>
      <p class="careers-intro">If you need a reasonable adjustment at any stage, tell us and we will arrange it.</p>
      <ol class="careers-steps">
        {process.map(step => (
          <li class="careers-step">
            <div class="careers-step-title">{step.title}</div>
            <div class="careers-step-desc">{step.desc}</div>
          </li>
        ))}
      </ol>
      <p class="careers-privacy">How we handle your details during recruitment is explained in our <a href="/recruitment-privacy">recruitment privacy notice</a>.</p>
    </div>
  </section>}

  <section class="sa-section sa-ink">
    <div class="sa-wrap sa-center" style="--sa-max: 600px">
      <p class="sa-eyebrow sa-eyebrow-light">Applications</p>
      {applyOpen ? (
        <Fragment>
          <h2 class="sa-display sa-display-light" style="--sa-size: 36px; margin-bottom: 14px">Apply to Fresh Tech</h2>
          <p class="careers-cta-lead">Email your CV to jobs@fresh-tech.uk with a few lines about where you're based and your notice period. No lengthy covering letter needed. Please send a PDF or Word document.</p><p class="careers-cta-lead">Don't include ID documents, your date of birth, medical details or DBS information. If you need an adjustment, ask Sam to arrange a private conversation.</p><p>Read our <a href="/recruitment-privacy">recruitment privacy notice</a> before applying.</p>
          <a class="sa-button" href={applications.listingUrl}>Email your application →</a>
        </Fragment>
      ) : (
        <Fragment>
          <h2 class="sa-display sa-display-light" style="--sa-size: 36px; margin-bottom: 14px">Applications have closed</h2>
          <p class="careers-cta-lead">We're not taking applications at the moment. Future roles will be posted on this page.</p>
          <p class="careers-cta-lead">If you applied, our <a href="/recruitment-privacy">recruitment privacy notice</a> explains how we handle your details and when we delete them.</p>
        </Fragment>
      )}
    </div>
  </section>
</StandaloneShell>

<style>
  .careers-hero-grid { display: grid; grid-template-columns: 1fr; gap: 36px; align-items: center; }
  @media (min-width: 768px) { .careers-hero-grid { grid-template-columns: 1.2fr 0.8fr; gap: 64px; } }
  .careers-lead { color: #b9c0c6; font-size: 18px; line-height: 1.65; margin: 0 0 12px; max-width: 46ch; }
  .careers-sub { color: #b9c0c6; font-size: 15px; line-height: 1.65; margin: 0 0 28px; max-width: 48ch; }
  .careers-stats { display: flex; flex-direction: column; gap: 12px; }
  .careers-stat { background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.15); padding: 20px 22px; }
  .careers-stat-n { font-family: 'SA Bungee', sans-serif; font-size: 26px; color: var(--yellow); line-height: 1; margin-bottom: 6px; overflow-wrap: anywhere; }
  .careers-stat-l { font-family: 'SA Archivo Narrow', sans-serif; font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: #b9c0c6; font-weight: 700; line-height: 1.4; }
  .careers-two-col { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: start; }
  @media (min-width: 768px) { .careers-two-col { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .careers-prose { font-size: 16px; line-height: 1.7; color: var(--ink); }
  .careers-prose p { margin: 0 0 14px; }
  .careers-h3 { font-family: 'SA Bungee', sans-serif; font-size: 15px; color: var(--primary-dark); margin: 20px 0 10px; line-height: 1.2; }
  .careers-list { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 15px; line-height: 1.6; color: var(--ink); }
  .careers-terms { margin: 0; display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 768px) { .careers-terms { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  .careers-term { background: var(--paper); border: 1px solid var(--hairline); padding: 20px 22px; }
  .careers-term dt { font-family: 'SA Bungee', sans-serif; font-size: 15px; color: var(--primary-dark); margin-bottom: 8px; line-height: 1.2; }
  .careers-term dd { margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink); }
  .careers-intro { font-size: 16px; line-height: 1.65; color: var(--ink); margin: 0 0 28px; max-width: 60ch; }
  .careers-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 16px; counter-reset: step; }
  @media (min-width: 768px) { .careers-steps { grid-template-columns: repeat(5, 1fr); } }
  .careers-step { background: var(--white); border: 1px solid var(--hairline); padding: 22px; counter-increment: step; }
  .careers-step-title { font-family: 'SA Bungee', sans-serif; font-size: 15px; line-height: 1.15; color: var(--ink); margin-bottom: 10px; }
  .careers-step-title::before { content: counter(step) '. '; color: var(--primary-dark); }
  .careers-step-desc { font-size: 14px; line-height: 1.65; color: var(--ink); }
  .careers-privacy { font-size: 15px; line-height: 1.6; color: var(--ink); margin: 28px 0 0; }
  .careers-privacy a { color: var(--primary-dark); font-weight: 600; }
  .careers-cta-lead { color: #b9c0c6; font-size: 16px; line-height: 1.65; margin: 0 auto 24px; max-width: 44ch; }
  .careers-cta-lead:last-child { margin-bottom: 0; }
  .careers-cta-lead a { color: var(--yellow); font-weight: 600; }
</style>
