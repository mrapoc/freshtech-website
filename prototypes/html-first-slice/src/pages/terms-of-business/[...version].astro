---
// Port of pages-v2/LegalDocumentPageV2.tsx for slug="terms-of-business"
// (App.tsx route "/terms-of-business/:version?"). getStaticPaths yields the
// current (no-version) URL and one URL per versioned document from
// src/generated/legal-data.mjs (extract-legal.mjs), exactly mirroring
// data/legalDocuments.ts's getLegalDocument(slug, requestedVersion).
import LegalDocument from '../../components/LegalDocument.astro';
import StandaloneShell from '../../layouts/StandaloneShell.astro';
import { legalRoutes } from '../../generated/legal-data.mjs';

export function getStaticPaths() {
  return legalRoutes
    .filter(route => route.slug === 'terms-of-business')
    .map(route => ({ params: { version: route.versionPath ?? undefined }, props: { route } }));
}

const { route } = Astro.props;
const path = route.versionPath ? `/terms-of-business/${route.versionPath}` : '/terms-of-business';
const name = route.versionPath ? `terms-of-business/${route.versionPath}` : 'terms-of-business';
const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: route.title, item: '/terms-of-business' },
  ...(route.versionPath ? [{ name: `Version ${route.version}`, item: path }] : []),
];
const seo = { path, title: route.title, description: route.summary, type: 'article', breadcrumbs };
---

<StandaloneShell name={name} seo={seo}>
  <LegalDocument route={route} path={path} />
</StandaloneShell>
