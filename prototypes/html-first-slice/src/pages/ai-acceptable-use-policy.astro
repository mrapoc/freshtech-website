      <a class="sa-button" href="/contact">Book a 20-min call →</a>
    </div>
  </section>
</StandaloneShell>

<script>
  const policy = document.querySelector('[data-standalone-page="ai-acceptable-use-policy"]');
  const copyBtn = document.getElementById('aaup-copy');
  const printBtn = document.getElementById('aaup-print');

  copyBtn?.addEventListener('click', async () => {
    const text = policy?.innerText ?? '';
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }
    const original = copyBtn.textContent;
    copyBtn.textContent = '✓ Copied';
    setTimeout(() => { copyBtn.textContent = original; }, 3000);
  });

  printBtn?.addEventListener('click', () => window.print());
</script>

