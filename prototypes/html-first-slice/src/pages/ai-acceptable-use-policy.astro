        </div>
      </div>
    </div>
  </section>

  <section class="sa-section sa-paper sa-rule">
    <div class="sa-wrap" style="--sa-max: 1100px">
      <p class="sa-eyebrow">Why your business needs one</p>
      <h2 class="sa-display" style="--sa-size: 32px; margin-bottom: 12px">AI is already in your business. Decide on the terms.</h2>
      <p class="aaup-why-lead">ChatGPT, Copilot, Gemini: your team is using them whether you have a policy or not. Without clear rules, you risk:</p>
      <div class="aaup-cards">
        {RISKS.map(r => (
          <div class="aaup-card">
            <div class="aaup-card-icon">{r.i}</div>
            <div class="aaup-card-title">{r.t}</div>
            <div class="aaup-card-desc">{r.d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sa-section sa-deep sa-rule">
    <div class="sa-wrap" style="--sa-max: 880px">
      <p class="aaup-toc-label">Contents</p>
      <div class="aaup-toc-grid">
        {SECTIONS.map(s => (
          <a href={`#section-${s.n}`} class="aaup-toc-link"><span class="aaup-toc-n">{s.n}.</span><span>{s.title}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="sa-section sa-paper">
    <div class="sa-wrap" style="--sa-max: 880px">
      <div class="sa-note">
        <strong>Version 1.0.</strong> Replace the <code class="aaup-code">[PLACEHOLDER]</code> fields throughout (e.g. <code class="aaup-code">[YOUR IT CONTACT]</code>) with your own company details before distributing.
      </div>

      {SECTIONS.map(s => (
        <div id={`section-${s.n}`} class="aaup-section">
          <div class="aaup-section-head">
            <div class="aaup-section-icon">{s.emoji}</div>
            <h2 class="aaup-section-title">{s.n}. {s.title}</h2>
          </div>
          <div class="aaup-section-body" set:html={renderBody(s.body)} />
        </div>
      ))}

