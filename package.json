{
  "name": "fresh-tech-msp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "check:legal-content": "node scripts/check-legal-placeholders.mjs",
    "build": "npm run check:legal-content && node scripts/generate-sitemap.js && node scripts/generate-rss.js && vite build && npm run build:ssr-home && node scripts/prerender.js && npm run check:page-budgets",
    "build:ssr-home": "vite build --ssr entry-server.tsx --outDir dist-ssr --emptyOutDir",
    "check:page-budgets": "node scripts/check-page-budgets.mjs",
    "build:no-prerender": "npm run check:legal-content && node scripts/generate-sitemap.js && node scripts/generate-rss.js && vite build",
    "build:sitemap": "node scripts/generate-sitemap.js",
    "build:rss": "node scripts/generate-rss.js",
    "gsc:submit": "node scripts/gsc-submit.mjs",
    "indexnow:submit": "node scripts/indexnow-submit.mjs",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css}\"",
    "test": "vitest run",
    "test:apache-static-config": "node --test scripts/generate-apache-static-config.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:built": "npm run build && playwright test --config=playwright.built.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "deploy:20i": "bash \"$HOME/Library/Application Support/freshtech-deploy/run.sh\"",
    "test:all": "vitest run && playwright test && npm run test:e2e:built",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "lucide-react": "^0.554.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.12.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "beasties": "0.5.4",
    "cloudinary": "^2.9.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^28.0.0",
    "parse5": "8.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.8.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.53.1",
    "vite": "^8.3.5",
    "vitest": "^4.0.18"
  }
}
